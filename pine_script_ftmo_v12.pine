// =============================================================================
// FTMO WYCKOFF MTF STRATEGY v12 — 15M ENTRY | 1H RANGE CONTEXT
// =============================================================================
// Range Logic:
//   1H HTF defines the structural range:
//   - Range HIGH = highest pivot high in lookback
//   - Range LOW  = lowest pivot low in lookback
//   - Range VALID when:
//       * 2+ wick touches on one boundary (wick enters zone = within 3% of range)
//       * 1+ wick touch  on other boundary
//       * 1+ mid cross   (1H candle spans the midpoint)
//       * Price has NOT closed 30% beyond either boundary (invalidation)
//
// Entry Logic:
//   - Price enters HIGH zone → wait for 15M bearish BOS (8-bar pivot) → 
//     retrace to BOS level → SHORT
//   - Price enters LOW zone  → wait for 15M bullish BOS (8-bar pivot) →
//     retrace to BOS level → LONG
//   - TP1 = mid | TP2 = opposite boundary
//   - Close 50% at TP1, move SL to entry, hold rest to TP2
//   - After TP1/SL hit: WAIT for price to visit OPPOSITE boundary before re-arming
//   - After breakeven SL hit: same — wait for opposite boundary visit
//
// Instruments : XAUUSD.SIM | US100.SIM | GBPUSD.SIM | USDJPY.SIM | EURUSD.SIM
// Webhook     : /webhook/ftmo
// Sizing      : 0.5% risk ($500) per trade, dynamic lot by SL distance
// =============================================================================

//@version=6
strategy(
     title             = "FTMO MTF Wyckoff v12 — 15M Entry",
     shorttitle        = "FTMO-MTF12",
     overlay           = true,
     pyramiding        = 0,
     default_qty_type  = strategy.fixed,
     default_qty_value = 0.01,
     currency          = currency.USD,
     commission_type   = strategy.commission.cash_per_contract,
     commission_value  = 0.0
 )

// =============================================================================
// INPUTS
// =============================================================================
zone_pct        = input.float(12.0, "Boundary Zone % of Range",     group="Range Settings", minval=1.0, maxval=20.0, step=0.5)
touch_min_major = input.int(2,     "Min touches — major boundary", group="Range Settings", minval=1)
touch_min_minor = input.int(1,     "Min touches — minor boundary", group="Range Settings", minval=1)
mid_cross_min   = input.int(1,     "Min mid crosses",              group="Range Settings", minval=1)

local_pivot_len = input.int(3,     "15M BOS Pivot Length (bars — fast, for BOS detection)", group="15M Entry", minval=2, maxval=15)
sl_pivot_len    = input.int(8,     "15M SL Pivot Length (bars — slow, for SL structure)",   group="15M Entry", minval=3, maxval=20)
min_rr          = input.float(1.5, "Min R:R to TP1",                                        group="15M Entry", minval=1.0, step=0.1)
max_retrace_pct = input.float(60.0,"Max Retrace from BOS (%)",          group="15M Entry", minval=20.0, maxval=100.0, step=5.0)

use_session     = input.bool(true,  "Weekday session filter",            group="Filters")
use_news        = input.bool(true,  "Block high-impact news windows",    group="Filters")

show_range      = input.bool(true,  "Show 1H range levels",             group="Display")
show_touches    = input.bool(true,  "Show boundary touch markers",      group="Display")
show_bos        = input.bool(true,  "Show BOS levels",                  group="Display")
show_signals    = input.bool(true,  "Show entry signals",               group="Display")
show_trade_lvls = input.bool(true,  "Show SL/TP levels on trade",       group="Display")
show_info       = input.bool(true,  "Show info table",                  group="Display")

// =============================================================================
// INSTRUMENT CONFIG
// =============================================================================
raw_ticker   = syminfo.tickerid
clean_ticker = str.replace(str.replace(raw_ticker, ".SIM", ""), "SIM", "")
symbol_name  = str.replace(str.replace(clean_ticker, "1!", ""), "!", "")

is_xauusd = str.contains(raw_ticker, "XAU")
is_usoil  = str.contains(raw_ticker, "OIL") or str.contains(raw_ticker, "WTI")
is_us100  = str.contains(raw_ticker, "US100") or str.contains(raw_ticker, "NAS")

pip_size          = is_xauusd ? 0.01 : is_usoil ? 0.01 : is_us100 ? 1.0  : syminfo.mintick * 10
price_format      = is_us100  ? "#.#" : is_xauusd ? "#.##" : "#.#####"
risk_dollars      = 500.0

// =============================================================================
// SESSION + NEWS FILTERS
// =============================================================================
is_weekday   = dayofweek != dayofweek.saturday and dayofweek != dayofweek.sunday
session_ok   = use_session ? is_weekday : true

et_hour      = hour(time, "America/New_York")
et_min_val   = et_hour * 100 + minute(time, "America/New_York")
news_blocked = use_news ? (
     (et_min_val >= 800  and et_min_val <= 900)  or
     (et_min_val >= 1330 and et_min_val <= 1430) or
     (et_min_val >= 230  and et_min_val <= 330)) : false
news_ok      = not news_blocked

// =============================================================================
// ATR
// =============================================================================
atr_now = ta.atr(14)

// =============================================================================
// RANGE — MANUAL LEVELS (set per chart per instrument)
// =============================================================================
// You define the structural range high and low.
// Script counts touches, mid crosses, handles BOS/entries/SL/TP automatically.
// Each chart instance saves its own levels independently in TradingView.
// When range breaks you get a Telegram alert to update the levels.
// =============================================================================

htf_h = request.security(syminfo.tickerid, "60", high,  lookahead=barmerge.lookahead_off)
htf_l = request.security(syminfo.tickerid, "60", low,   lookahead=barmerge.lookahead_off)
htf_c = request.security(syminfo.tickerid, "60", close, lookahead=barmerge.lookahead_off)

// ── UPDATE THESE WHEN A RANGE BREAKS ─────────────────────
us100_high  = 29700.0,  us100_low  = 28660.0,  us100_start  = timestamp("2026-05-07 00:00")
us500_high  = 7524.0,   us500_low  = 7345.0,   us500_start  = timestamp("2026-05-07 00:00")
us30_high   = 50200.0,  us30_low   = 48500.0,  us30_start   = timestamp("2026-04-29 00:00")
xau_high    = 4772.0,   xau_low    = 4500.0,   xau_start    = timestamp("2026-05-04 00:00")
xag_high    = 87.0,     xag_low    = 70.0,     xag_start    = timestamp("2026-04-29 00:00")
oil_high    = 113.0,    oil_low    = 82.0,     oil_start    = timestamp("2026-04-17 00:00")
btc_high    = 82000.0,  btc_low    = 63000.0,  btc_start    = timestamp("2026-02-23 00:00")
eur_high    = 1.18489,  eur_low    = 1.1437,   eur_start    = timestamp("2026-03-13 00:00")
gbp_high    = 1.3658,   gbp_low    = 1.3180,   gbp_start    = timestamp("2026-02-12 00:00")
jpy_high    = 160.45,   jpy_low    = 155.58,   jpy_start    = timestamp("2026-03-27 00:00")
eurnzd_high = 2.029,    eurnzd_low = 1.97193,  eurnzd_start = timestamp("2026-04-07 00:00")
// ─────────────────────────────────────────────────────────

// Symbol detection — additional instruments
is_us500  = str.contains(raw_ticker, "US500") or str.contains(raw_ticker, "SPX")
is_us30   = str.contains(raw_ticker, "US30")  or str.contains(raw_ticker, "DJI")
is_xag    = str.contains(raw_ticker, "XAG")
is_btc    = str.contains(raw_ticker, "BTC")
is_eur    = str.contains(raw_ticker, "EURUSD")
is_gbp    = str.contains(raw_ticker, "GBPUSD")
is_jpy    = str.contains(raw_ticker, "USDJPY")
is_eurnzd = str.contains(raw_ticker, "EURNZD")

htf_struct_high  = is_us100  ? us100_high  : is_us500  ? us500_high  : is_us30   ? us30_high  :
                   is_xauusd ? xau_high    : is_xag    ? xag_high    : is_usoil  ? oil_high   :
                   is_btc    ? btc_high    : is_eur    ? eur_high    : is_gbp    ? gbp_high   :
                   is_jpy    ? jpy_high    : is_eurnzd ? eurnzd_high : na

htf_struct_low   = is_us100  ? us100_low   : is_us500  ? us500_low   : is_us30   ? us30_low   :
                   is_xauusd ? xau_low     : is_xag    ? xag_low     : is_usoil  ? oil_low    :
                   is_btc    ? btc_low     : is_eur    ? eur_low     : is_gbp    ? gbp_low    :
                   is_jpy    ? jpy_low     : is_eurnzd ? eurnzd_low  : na

range_start_date = is_us100  ? us100_start  : is_us500  ? us500_start  : is_us30   ? us30_start  :
                   is_xauusd ? xau_start    : is_xag    ? xag_start    : is_usoil  ? oil_start   :
                   is_btc    ? btc_start    : is_eur    ? eur_start    : is_gbp    ? gbp_start   :
                   is_jpy    ? jpy_start    : is_eurnzd ? eurnzd_start : timestamp("2020-01-01")

htf_range = not na(htf_struct_high) and not na(htf_struct_low) and htf_struct_high > htf_struct_low ?
     htf_struct_high - htf_struct_low : na
htf_mid   = not na(htf_range) ? (htf_struct_high + htf_struct_low) / 2 : na

zone_size = not na(htf_range) ? htf_range * (zone_pct / 100.0) : na

// Count 1H wick touches per boundary — reset when levels change
var int   high_touches      = 0
var int   low_touches       = 0
var int   mid_crosses       = 0
var bool  last_touched_high = false
var bool  last_touched_low  = false
var bool  htf_range_broken  = false
// Levels fixed per instrument — counters persist across bars

// Only count touches and invalidation from range_start_date onwards
after_start = time >= range_start_date

if not na(zone_size) and not na(htf_struct_high) and not na(htf_struct_low) and after_start
    if htf_h >= htf_struct_high - zone_size and not last_touched_high
        high_touches      += 1
        last_touched_high := true
    else if htf_h < htf_struct_high - zone_size * 2
        last_touched_high := false

    if htf_l <= htf_struct_low + zone_size and not last_touched_low
        low_touches      += 1
        last_touched_low := true
    else if htf_l > htf_struct_low + zone_size * 2
        last_touched_low := false

    if htf_h >= htf_mid and htf_l <= htf_mid
        mid_crosses += 1

// Invalidation: 1H close 30% beyond boundary — fires range-break Telegram alert
invalidation_dist = not na(htf_range) ? htf_range * 0.30 : na
range_broken_up   = not na(htf_struct_high) and not na(invalidation_dist) and
     htf_c > htf_struct_high + invalidation_dist
range_broken_down = not na(htf_struct_low) and not na(invalidation_dist) and
     htf_c < htf_struct_low - invalidation_dist

var bool prev_range_broken = false
if (range_broken_up or range_broken_down) and not prev_range_broken and after_start
    htf_range_broken  := true
    prev_range_broken := true
    alert('{"event":"range_break","account":"FTMO","symbol":"' + symbol_name +
         '","direction":"' + (range_broken_up ? "UP" : "DOWN") +
         '","range_high":' + str.tostring(htf_struct_high, price_format) +
         ',"range_low":'  + str.tostring(htf_struct_low,  price_format) +
         ',"price":'      + str.tostring(close, price_format) +
         ',"token":"ftmo_xK9mP2qL8nR4vT7w"}',
         alert.freq_once_per_bar_close)
else if not range_broken_up and not range_broken_down
    prev_range_broken := false

major_touches = math.max(high_touches, low_touches)
minor_touches = math.min(high_touches, low_touches)

htf_range_valid = not na(htf_struct_high) and not na(htf_struct_low) and
     not na(htf_range) and htf_range > 0 and
     major_touches >= touch_min_major and
     minor_touches >= touch_min_minor and
     mid_crosses   >= mid_cross_min   and
     not htf_range_broken

near_htf_high = not na(htf_struct_high) and not na(zone_size) and
     math.abs(close - htf_struct_high) <= zone_size
near_htf_low  = not na(htf_struct_low) and not na(zone_size) and
     math.abs(close - htf_struct_low) <= zone_size

// Latched zone memory — stays TRUE after price enters zone until clearly departed
// Prevents BOS 2-bar confirmation from failing as price moves away from zone
var bool was_near_high = false
var bool was_near_low  = false

if near_htf_high
    was_near_high := true
if not na(htf_struct_high) and not na(zone_size) and close < htf_struct_high - zone_size * 3
    was_near_high := false

if near_htf_low
    was_near_low := true
if not na(htf_struct_low) and not na(zone_size) and close > htf_struct_low + zone_size * 3
    was_near_low := false

// =============================================================================
// BOUNDARY ROTATION GATE
// After a trade closes (TP1, TP2 or SL), the bot must wait for price to visit
// the OPPOSITE boundary before re-arming at the same side.
// State: "high" = armed at high, "low" = armed at low, "none" = waiting
// =============================================================================
var string armed_side       = "both"   // "both" on first load, "high", "low", "none"
var bool   waiting_for_high = false    // after low-side trade, wait for high visit
var bool   waiting_for_low  = false    // after high-side trade, wait for low visit

// Update rotation gate
if waiting_for_high and near_htf_high
    waiting_for_high := false
    armed_side       := "high"
if waiting_for_low and near_htf_low
    waiting_for_low  := false
    armed_side       := "low"

can_trade_high = htf_range_valid and (armed_side == "both" or armed_side == "high")
can_trade_low  = htf_range_valid and (armed_side == "both" or armed_side == "low")

// =============================================================================
// 15M LOCAL BOS DETECTION — fast pivot (bos_pivot_len=3)
// =============================================================================
local_ph = ta.pivothigh(high, local_pivot_len, local_pivot_len)
local_pl = ta.pivotlow(low,   local_pivot_len, local_pivot_len)

var float last_local_ph = na
var float last_local_pl = na

if not na(local_ph)
    last_local_ph := local_ph
if not na(local_pl)
    last_local_pl := local_pl

// SL anchor — slow pivot (sl_pivot_len=8), finds meaningful structural swing
// Decoupled from BOS pivots so tight BOS detection doesn't produce tight SL
sl_ph = ta.pivothigh(high, sl_pivot_len, sl_pivot_len)
sl_pl = ta.pivotlow(low,   sl_pivot_len, sl_pivot_len)

var float last_sl_ph_wick = na
var float last_sl_pl_wick = na

if not na(sl_ph)
    last_sl_ph_wick := high[sl_pivot_len]
if not na(sl_pl)
    last_sl_pl_wick := low[sl_pivot_len]

// Bearish BOS: 2 consecutive closes below local pivot low (at range high)
local_bearish_bos = was_near_high and can_trade_high and not na(last_local_pl) and
     close[1] < last_local_pl and close[2] < last_local_pl

// Bullish BOS: 2 consecutive closes above local pivot high (at range low)
local_bullish_bos = was_near_low and can_trade_low and not na(last_local_ph) and
     close[1] > last_local_ph and close[2] > last_local_ph

var int  bos_bear_entry_bar = -1   // bar_index when last short entry fired
var int  bos_bull_entry_bar = -1   // bar_index when last long entry fired
var int  bos_bear_bar       = -1   // bar_index when last bearish BOS formed
var int  bos_bull_bar       = -1   // bar_index when last bullish BOS formed

var float bos_bear_level   = na
var float bos_bear_sl_wick = na
var bool  bos_bear_active  = false

var float bos_bull_level   = na
var float bos_bull_sl_wick = na
var bool  bos_bull_active  = false

if local_bearish_bos
    bos_bear_level   := last_local_pl
    bos_bear_sl_wick := last_sl_ph_wick
    bos_bear_active  := true
    bos_bear_bar     := bar_index
    bos_bull_active  := false

if local_bullish_bos
    bos_bull_level   := last_local_ph
    bos_bull_sl_wick := last_sl_pl_wick
    bos_bull_active  := true
    bos_bull_bar     := bar_index
    bos_bear_active  := false

// =============================================================================
// RETRACEMENT DETECTION
// =============================================================================
short_retrace_dist = bos_bear_active and not na(bos_bear_level) ?
     math.abs(close - bos_bear_level) : na
max_retrace        = not na(htf_range) ? htf_range * (max_retrace_pct / 100.0) : na

short_retracing = bos_bear_active and not na(short_retrace_dist) and
     not na(max_retrace) and
     short_retrace_dist <= max_retrace and
     close >= bos_bear_level and
     close < htf_struct_high

long_retrace_dist = bos_bull_active and not na(bos_bull_level) ?
     math.abs(close - bos_bull_level) : na

long_retracing = bos_bull_active and not na(long_retrace_dist) and
     not na(max_retrace) and
     long_retrace_dist <= max_retrace and
     close <= bos_bull_level and
     close > htf_struct_low

// =============================================================================
// SL / TP / R:R
// =============================================================================
short_entry  = close
// SL: above range high boundary with 0.5 ATR buffer — structural anchor, not pivot wick
short_sl     = not na(htf_struct_high) ? htf_struct_high + (atr_now * 0.5) : na
short_tp1    = htf_mid
short_tp2    = htf_struct_low
short_risk   = not na(short_sl) ? short_sl - short_entry : na
short_rwd1   = not na(short_tp1) ? short_entry - short_tp1 : na
short_rr1    = not na(short_risk) and short_risk > 0 ? short_rwd1 / short_risk : 0.0
short_rr_ok  = short_rr1 >= min_rr

long_entry   = close
// SL: below range low boundary with 0.5 ATR buffer — structural anchor, not pivot wick
long_sl      = not na(htf_struct_low) ? htf_struct_low - (atr_now * 0.5) : na
long_tp1     = htf_mid
long_tp2     = htf_struct_high
long_risk    = not na(long_sl) ? long_entry - long_sl : na
long_rwd1    = not na(long_tp1) ? long_tp1 - long_entry : na
long_rr1     = not na(long_risk) and long_risk > 0 ? long_rwd1 / long_risk : 0.0
long_rr_ok   = long_rr1 >= min_rr

// =============================================================================
// SIZING
// =============================================================================
// Universal formula: qty = risk_dollars / (sl_distance * syminfo.pointvalue)
// syminfo.pointvalue is USD per price-point per contract for any instrument
_size(entry_p, sl_p) =>
    sl_dist = not na(sl_p) ? math.max(math.abs(entry_p - sl_p), syminfo.mintick) : syminfo.mintick
    math.max(1, math.round(risk_dollars / (sl_dist * syminfo.pointvalue)))

_half(sz) => math.max(1, math.round(sz / 2))

short_lots     = _size(short_entry, short_sl)
short_tp1_lots = _half(short_lots)
long_lots      = _size(long_entry, long_sl)
long_tp1_lots  = _half(long_lots)

// =============================================================================
// FINAL SIGNALS
// =============================================================================
// One entry per BOS: only fire if this BOS bar hasn't been traded yet
// bos_bear_entry_bar tracks bar_index of last short entry — must be before current BOS
short_signal = short_retracing and short_rr_ok and session_ok and news_ok and not na(short_sl) and bos_bear_entry_bar < bos_bear_bar
long_signal  = long_retracing  and long_rr_ok  and session_ok and news_ok and not na(long_sl)  and bos_bull_entry_bar < bos_bull_bar

// =============================================================================
// STRATEGY EXECUTION
// =============================================================================
// Use opentrades == 0 (not position_size) — position_size can be non-zero after
// partial TP1 exit, causing re-entries on the same bar. barstate.isconfirmed
// ensures signals only fire on confirmed closed bars, never intra-bar.
no_position = strategy.opentrades == 0

if short_signal and no_position
    strategy.entry("SHORT", strategy.short, qty=short_lots,
         comment="SHORT " + str.tostring(short_lots) + "L RR:" + str.tostring(short_rr1, "#.#"))
    strategy.exit("SHORT_TP1", from_entry="SHORT", qty=short_tp1_lots,
         limit=short_tp1, stop=short_sl, comment="TP1")
    strategy.exit("SHORT_TP2", from_entry="SHORT",
         limit=short_tp2, stop=short_sl, comment="TP2+SL")
    alert('{"event":"entry_filled","account":"FTMO","symbol":"' + symbol_name +
         '","direction":"SHORT","timeframe":"15"' +
         ',"lot_size":' + str.tostring(short_lots) +
         ',"entry_price":' + str.tostring(short_entry, price_format) +
         ',"stop_loss":' + str.tostring(short_sl, price_format) +
         ',"tp1":' + str.tostring(short_tp1, price_format) +
         ',"tp2":' + str.tostring(short_tp2, price_format) +
         ',"rr_to_tp1":' + str.tostring(short_rr1, "#.##") +
         ',"htf_range_high":' + str.tostring(htf_struct_high, price_format) +
         ',"htf_range_low":' + str.tostring(htf_struct_low, price_format) +
         ',"htf_mid":' + str.tostring(htf_mid, price_format) +
         ',"bos_level":' + str.tostring(bos_bear_level, price_format) +
         ',"token":"ftmo_xK9mP2qL8nR4vT7w"}',
         alert.freq_once_per_bar_close)
    bos_bear_entry_bar := bar_index  // latch — blocks any further entry on this BOS
    bos_bear_active  := false
    bos_bull_active  := false
    waiting_for_low  := true
    armed_side       := "none"

if long_signal and no_position
    strategy.entry("LONG", strategy.long, qty=long_lots,
         comment="LONG " + str.tostring(long_lots) + "L RR:" + str.tostring(long_rr1, "#.#"))
    strategy.exit("LONG_TP1", from_entry="LONG", qty=long_tp1_lots,
         limit=long_tp1, stop=long_sl, comment="TP1")
    strategy.exit("LONG_TP2", from_entry="LONG",
         limit=long_tp2, stop=long_sl, comment="TP2+SL")
    alert('{"event":"entry_filled","account":"FTMO","symbol":"' + symbol_name +
         '","direction":"LONG","timeframe":"15"' +
         ',"lot_size":' + str.tostring(long_lots) +
         ',"entry_price":' + str.tostring(long_entry, price_format) +
         ',"stop_loss":' + str.tostring(long_sl, price_format) +
         ',"tp1":' + str.tostring(long_tp1, price_format) +
         ',"tp2":' + str.tostring(long_tp2, price_format) +
         ',"rr_to_tp1":' + str.tostring(long_rr1, "#.##") +
         ',"htf_range_high":' + str.tostring(htf_struct_high, price_format) +
         ',"htf_range_low":' + str.tostring(htf_struct_low, price_format) +
         ',"htf_mid":' + str.tostring(htf_mid, price_format) +
         ',"bos_level":' + str.tostring(bos_bull_level, price_format) +
         ',"token":"ftmo_xK9mP2qL8nR4vT7w"}',
         alert.freq_once_per_bar_close)
    bos_bull_entry_bar := bar_index  // latch — blocks any further entry on this BOS
    bos_bear_active  := false
    bos_bull_active  := false
    waiting_for_high := true
    armed_side       := "none"

// =============================================================================
// TP1 HIT — MOVE SL TO ENTRY (breakeven)
// After TP1 hit, update exit to move SL to entry price for remaining position
// =============================================================================
var float entry_price_stored = na
var string last_direction    = na

if short_signal and no_position
    entry_price_stored := short_entry
    last_direction     := "SHORT"
if long_signal and no_position
    entry_price_stored := long_entry
    last_direction     := "LONG"

var float prev_pos = 0.0
pos_changed = strategy.position_size != prev_pos

// TP1 hit detected: position reduced but still open
tp1_short_hit = prev_pos < 0 and strategy.position_size < 0 and strategy.position_size > prev_pos and pos_changed
tp1_long_hit  = prev_pos > 0 and strategy.position_size > 0 and strategy.position_size < prev_pos and pos_changed

// Move SL to entry when TP1 hit
if tp1_short_hit and not na(entry_price_stored)
    strategy.exit("SHORT_TP2_BE", from_entry="SHORT",
         limit=short_tp2, stop=entry_price_stored, comment="TP2 BE")

if tp1_long_hit and not na(entry_price_stored)
    strategy.exit("LONG_TP2_BE", from_entry="LONG",
         limit=long_tp2, stop=entry_price_stored, comment="TP2 BE")

// =============================================================================
// LIFECYCLE ALERTS
// =============================================================================
_n = strategy.closedtrades - 1

tp2_short_hit = prev_pos < 0 and strategy.position_size == 0 and _n >= 0 and strategy.closedtrades.exit_price(_n) <= strategy.closedtrades.entry_price(_n)
tp2_long_hit  = prev_pos > 0 and strategy.position_size == 0 and _n >= 0 and strategy.closedtrades.exit_price(_n) >= strategy.closedtrades.entry_price(_n)
sl_short_hit  = prev_pos < 0 and strategy.position_size == 0 and _n >= 0 and strategy.closedtrades.exit_price(_n) > strategy.closedtrades.entry_price(_n)
sl_long_hit   = prev_pos > 0 and strategy.position_size == 0 and _n >= 0 and strategy.closedtrades.exit_price(_n) < strategy.closedtrades.entry_price(_n)

last_pnl        = _n >= 0 ? strategy.closedtrades.profit(_n) : 0.0
last_exit_price = _n >= 0 ? strategy.closedtrades.exit_price(_n) : close

if tp1_short_hit
    alert('{"event":"tp1_hit","account":"FTMO","symbol":"' + symbol_name + '","direction":"SHORT","price":' + str.tostring(last_exit_price, price_format) + ',"lot_size":' + str.tostring(math.abs(prev_pos - strategy.position_size)) + ',"pnl":' + str.tostring(last_pnl) + ',"token":"ftmo_xK9mP2qL8nR4vT7w"}', alert.freq_once_per_bar_close)
if tp1_long_hit
    alert('{"event":"tp1_hit","account":"FTMO","symbol":"' + symbol_name + '","direction":"LONG","price":' + str.tostring(last_exit_price, price_format) + ',"lot_size":' + str.tostring(math.abs(prev_pos - strategy.position_size)) + ',"pnl":' + str.tostring(last_pnl) + ',"token":"ftmo_xK9mP2qL8nR4vT7w"}', alert.freq_once_per_bar_close)
if tp2_short_hit
    alert('{"event":"tp2_hit","account":"FTMO","symbol":"' + symbol_name + '","direction":"SHORT","price":' + str.tostring(last_exit_price, price_format) + ',"lot_size":' + str.tostring(math.abs(prev_pos)) + ',"pnl":' + str.tostring(last_pnl) + ',"token":"ftmo_xK9mP2qL8nR4vT7w"}', alert.freq_once_per_bar_close)
if tp2_long_hit
    alert('{"event":"tp2_hit","account":"FTMO","symbol":"' + symbol_name + '","direction":"LONG","price":' + str.tostring(last_exit_price, price_format) + ',"lot_size":' + str.tostring(math.abs(prev_pos)) + ',"pnl":' + str.tostring(last_pnl) + ',"token":"ftmo_xK9mP2qL8nR4vT7w"}', alert.freq_once_per_bar_close)
if sl_short_hit
    alert('{"event":"sl_hit","account":"FTMO","symbol":"' + symbol_name + '","direction":"SHORT","price":' + str.tostring(last_exit_price, price_format) + ',"lot_size":' + str.tostring(math.abs(prev_pos)) + ',"pnl":' + str.tostring(last_pnl) + ',"token":"ftmo_xK9mP2qL8nR4vT7w"}', alert.freq_once_per_bar_close)
    // After SL on short (high side), must revisit low before re-arming
    waiting_for_low  := true
    armed_side       := "none"
if sl_long_hit
    alert('{"event":"sl_hit","account":"FTMO","symbol":"' + symbol_name + '","direction":"LONG","price":' + str.tostring(last_exit_price, price_format) + ',"lot_size":' + str.tostring(math.abs(prev_pos)) + ',"pnl":' + str.tostring(last_pnl) + ',"token":"ftmo_xK9mP2qL8nR4vT7w"}', alert.freq_once_per_bar_close)
    // After SL on long (low side), must revisit high before re-arming
    waiting_for_high := true
    armed_side       := "none"

prev_pos := strategy.position_size

// =============================================================================
// VISUALS
// =============================================================================

// ── Range lines — use var float so value is constant across all bars ─────
var float plot_high = na
var float plot_mid  = na
var float plot_low  = na

if na(plot_high) and not na(htf_struct_high)
    plot_high := htf_struct_high
    plot_mid  := htf_mid
    plot_low  := htf_struct_low

plot(show_range ? plot_high : na, "Range High", color=color.new(color.red,   0), linewidth=2, style=plot.style_line)
plot(show_range ? plot_mid  : na, "Range Mid",  color=color.new(color.gray, 30), linewidth=1, style=plot.style_line)
plot(show_range ? plot_low  : na, "Range Low",  color=color.new(color.green, 0), linewidth=2, style=plot.style_line)

if barstate.islast and show_range and not na(plot_high)
    label.new(bar_index + 2, plot_high, "RANGE HIGH  " + str.tostring(plot_high, price_format) + "  [" + str.tostring(high_touches) + "T]", color=color.new(color.red,80),   textcolor=color.red,   style=label.style_label_left, size=size.small)
    label.new(bar_index + 2, plot_mid,  "MID  "        + str.tostring(plot_mid,  price_format),                                             color=color.new(color.gray,80),  textcolor=color.gray,  style=label.style_label_left, size=size.small)
    label.new(bar_index + 2, plot_low,  "RANGE LOW  "  + str.tostring(plot_low,  price_format) + "  [" + str.tostring(low_touches) + "T]",  color=color.new(color.green,80), textcolor=color.green, style=label.style_label_left, size=size.small)

// ── Entry zone shading ────────────────────────────────────
bgcolor(near_htf_high ? color.new(color.red,   92) : na, title="High zone")
bgcolor(near_htf_low  ? color.new(color.green, 92) : na, title="Low zone")

// ── BOS levels ────────────────────────────────────────────
plot(show_bos and bos_bear_active ? bos_bear_level : na, "Bear BOS", color=color.new(color.orange, 20), linewidth=1, style=plot.style_linebr)
plot(show_bos and bos_bull_active ? bos_bull_level : na, "Bull BOS", color=color.new(color.blue,   20), linewidth=1, style=plot.style_linebr)

if show_bos and local_bearish_bos
    label.new(bar_index, high, "BOS ↓", color=color.orange, textcolor=color.white, style=label.style_label_down, size=size.small)
if show_bos and local_bullish_bos
    label.new(bar_index, low,  "BOS ↑", color=color.blue,   textcolor=color.white, style=label.style_label_up,   size=size.small)

// ── Entry signals ─────────────────────────────────────────
plotshape(show_signals and short_signal, "SHORT ▼", shape.triangledown, location.abovebar, color.new(color.red,   0), size=size.normal)
plotshape(show_signals and long_signal,  "LONG ▲",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.normal)

// ── Trade level lines — use persistent vars + plot ────────
var float active_entry = na
var float active_sl    = na
var float active_tp1   = na
var float active_tp2   = na
var string active_dir  = na
var float active_rr    = na

if short_signal or long_signal
    active_entry := short_signal ? short_entry : long_entry
    active_sl    := short_signal ? short_sl    : long_sl
    active_tp1   := short_signal ? short_tp1   : long_tp1
    active_tp2   := short_signal ? short_tp2   : long_tp2
    active_dir   := short_signal ? "SHORT"     : "LONG"
    active_rr    := short_signal ? short_rr1   : long_rr1

if strategy.position_size == 0 and prev_pos != 0
    active_entry := na
    active_sl    := na
    active_tp1   := na
    active_tp2   := na

plot(show_trade_lvls and not na(active_entry) ? active_entry : na, "Entry",  color=color.white,               linewidth=1, style=plot.style_linebr)
plot(show_trade_lvls and not na(active_sl)    ? active_sl    : na, "SL",     color=color.red,                 linewidth=2, style=plot.style_linebr)
plot(show_trade_lvls and not na(active_tp1)   ? active_tp1   : na, "TP1",    color=color.new(color.green, 30),linewidth=1, style=plot.style_linebr)
plot(show_trade_lvls and not na(active_tp2)   ? active_tp2   : na, "TP2",    color=color.green,               linewidth=2, style=plot.style_linebr)

if show_trade_lvls and (short_signal or long_signal) and barstate.isconfirmed
    _e = short_signal ? short_entry : long_entry
    _s = short_signal ? short_sl    : long_sl
    _t1= short_signal ? short_tp1   : long_tp1
    _t2= short_signal ? short_tp2   : long_tp2
    _r = short_signal ? short_rr1   : long_rr1
    _d = short_signal ? "SHORT" : "LONG"
    label.new(bar_index, _e,  _d + "  ENTRY  " + str.tostring(_e, price_format),                           color=color.new(color.white,80), textcolor=color.white, style=label.style_label_left, size=size.small)
    label.new(bar_index, _s,  "SL  " + str.tostring(_s, price_format),                                     color=color.new(color.red,80),   textcolor=color.red,   style=label.style_label_left, size=size.small)
    label.new(bar_index, _t1, "TP1  " + str.tostring(_t1, price_format) + "  RR:" + str.tostring(_r,"#.#"),color=color.new(color.green,80), textcolor=color.green, style=label.style_label_left, size=size.small)
    label.new(bar_index, _t2, "TP2  " + str.tostring(_t2, price_format),                                    color=color.new(color.green,80), textcolor=color.green, style=label.style_label_left, size=size.small)

// ── Retracement RR labels ─────────────────────────────────
if show_signals and short_retracing and not short_signal
    label.new(bar_index, high, "RR:" + str.tostring(short_rr1, "#.#") + (short_rr_ok ? "" : " ✗"),
         color=short_rr_ok ? color.new(color.red,70) : color.new(color.gray,70),
         textcolor=color.white, style=label.style_label_down, size=size.tiny)
if show_signals and long_retracing and not long_signal
    label.new(bar_index, low, "RR:" + str.tostring(long_rr1, "#.#") + (long_rr_ok ? "" : " ✗"),
         color=long_rr_ok ? color.new(color.green,70) : color.new(color.gray,70),
         textcolor=color.white, style=label.style_label_up, size=size.tiny)

bgcolor(news_blocked ? color.new(color.orange, 92) : na, title="News block")

// =============================================================================
// INFO TABLE
// =============================================================================
var table info = table.new(position.top_right, 2, 15, bgcolor=color.new(color.black, 70), border_width=1)
if show_info
    bos_state    = bos_bear_active ? "BEAR ACTIVE" : bos_bull_active ? "BULL ACTIVE" : "NONE"
    arm_display  = armed_side == "none" ? ("WAIT→" + (waiting_for_high ? "HIGH" : "LOW")) : armed_side == "both" ? "BOTH" : str.upper(armed_side)
    range_status = htf_range_valid ? "VALID" : htf_range_broken ? "BROKEN" :
         (not na(htf_struct_high) and not na(htf_struct_low)) ? "BUILDING" : "SET LEVELS"

    table.cell(info, 0, 0,  "FTMO MTF v12",       text_color=color.white, text_size=size.normal)
    table.cell(info, 1, 0,  "15M entry | Manual range",  text_color=color.yellow)
    table.cell(info, 0, 1,  "Symbol",             text_color=color.gray)
    table.cell(info, 1, 1,  symbol_name,          text_color=color.white)
    table.cell(info, 0, 2,  "Range",           text_color=color.gray)
    table.cell(info, 1, 2,  range_status,         text_color=htf_range_valid ? color.green : htf_range_broken ? color.red : color.gray)
    table.cell(info, 0, 3,  "Range High",         text_color=color.gray)
    table.cell(info, 1, 3,  not na(htf_struct_high) ? str.tostring(htf_struct_high, price_format) : "--", text_color=color.red)
    table.cell(info, 0, 4,  "Range Mid",          text_color=color.gray)
    table.cell(info, 1, 4,  not na(htf_mid) ? str.tostring(htf_mid, price_format) : "--", text_color=color.white)
    table.cell(info, 0, 5,  "Range Low",          text_color=color.gray)
    table.cell(info, 1, 5,  not na(htf_struct_low) ? str.tostring(htf_struct_low, price_format) : "--", text_color=color.green)
    table.cell(info, 0, 6,  "High Touches",       text_color=color.gray)
    table.cell(info, 1, 6,  str.tostring(high_touches), text_color=high_touches >= touch_min_major or high_touches >= touch_min_minor ? color.green : color.gray)
    table.cell(info, 0, 7,  "Low Touches",        text_color=color.gray)
    table.cell(info, 1, 7,  str.tostring(low_touches),  text_color=low_touches  >= touch_min_major or low_touches  >= touch_min_minor ? color.green : color.gray)
    table.cell(info, 0, 8,  "Mid Crosses",        text_color=color.gray)
    table.cell(info, 1, 8,  str.tostring(mid_crosses) + "/" + str.tostring(mid_cross_min), text_color=mid_crosses >= mid_cross_min ? color.green : color.gray)
    table.cell(info, 0, 9,  "At Level",           text_color=color.gray)
    table.cell(info, 1, 9,  near_htf_high ? "HIGH ZONE" : near_htf_low ? "LOW ZONE" : "--", text_color=near_htf_high ? color.red : near_htf_low ? color.green : color.gray)
    table.cell(info, 0, 10, "Armed Side",         text_color=color.gray)
    table.cell(info, 1, 10, arm_display,          text_color=armed_side == "none" ? color.orange : color.green)
    table.cell(info, 0, 11, "Local BOS",          text_color=color.gray)
    table.cell(info, 1, 11, bos_state,            text_color=bos_bear_active ? color.orange : bos_bull_active ? color.blue : color.gray)
    table.cell(info, 0, 12, "Retracing",          text_color=color.gray)
    table.cell(info, 1, 12, short_retracing ? "SHORT ↩" : long_retracing ? "LONG ↩" : "--", text_color=short_retracing ? color.red : long_retracing ? color.green : color.gray)
    table.cell(info, 0, 13, "R:R",                text_color=color.gray)
    table.cell(info, 1, 13, short_retracing ? str.tostring(short_rr1,"#.##")+":1" : long_retracing ? str.tostring(long_rr1,"#.##")+":1" : "--", text_color=color.white)
    table.cell(info, 0, 14, "Session/News",       text_color=color.gray)
    table.cell(info, 1, 14, session_ok and news_ok ? "CLEAR" : "BLOCKED", text_color=session_ok and news_ok ? color.green : color.red)

// =============================================================================
// WEBHOOK: /webhook/ftmo
// Load on 15M chart — XAUUSD.SIM / US100.SIM / GBPUSD.SIM etc (FTMO OANDA)
// Alert URL: https://tradingbot-production-1e5a.up.railway.app/webhook/ftmo
// v12 changes: decoupled bos_pivot_len(3) from sl_pivot_len(8) — fast BOS, structural SL
// =============================================================================
