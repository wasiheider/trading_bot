// =============================================================================
// PAPER TRADING — WYCKOFF MTF STRATEGY v3
// 1H Auto-Range | 15M BOS | 5M Retest Entry
// =============================================================================
// Range Logic:
//   Range High = last confirmed 1H pivot high  (auto-updates, no manual input)
//   Range Low  = last confirmed 1H pivot low   (auto-updates, no manual input)
//   Mid        = (Range High + Range Low) / 2
//   Works on every instrument without touching the code.
//
// Entry Logic:
//   Near HIGH zone → 15M bearish BOS → 5M rejection candle at BOS level → SHORT
//   Near LOW  zone → 15M bullish BOS → 5M rejection candle at BOS level → LONG
//   TP1 = range mid  |  TP2 = opposite boundary
//   SL  = range boundary ± ATR(14) * atr_mult  (trade invalidation — not BOS-level tight stop)
//   At TP1: close 50% of position, move SL to breakeven
//
// Chart       : Load on 5M
// Webhook     : https://tradingbot-production-1e5a.up.railway.app/webhook/paper
// Token       : paper_wasirizvi_wyckoffstrategy
// =============================================================================

//@version=6
strategy(
     title             = "Paper MTF Wyckoff v3 — 1H Range / 15M BOS / 5M Entry",
     shorttitle        = "PAPER-MTF3",
     overlay           = true,
     pyramiding        = 0,
     default_qty_type  = strategy.fixed,
     default_qty_value = 0.01,
     currency          = currency.USD,
     commission_type   = strategy.commission.cash_per_contract,
     commission_value  = 0.0
 )

// =============================================================================
// INPUTS
// =============================================================================
h1_lookback     = input.int(20,    "1H Range Lookback (bars)",            group="Range",  minval=5,   maxval=100)
zone_pct        = input.float(8.0, "Boundary Zone % of Range",            group="Range",  minval=1.0, maxval=20.0, step=0.5)

m15_bos_len     = input.int(3,     "15M BOS Pivot Length",                group="Entry",  minval=2,   maxval=10)
min_rr          = input.float(1.5, "Min R:R to TP1",                      group="Entry",  minval=1.0, step=0.1)
atr_mult        = input.float(1.0, "ATR Buffer above/below range boundary (x ATR)", group="Entry",  minval=0.1, step=0.1)
max_retrace_pct = input.float(60.0,"Max Retrace — invalidate BOS (%)",    group="Entry",  minval=10.0,maxval=90.0, step=5.0)

use_rotation    = input.bool(true,  "Boundary Rotation Gate",             group="Filters")
max_break_pct   = input.float(15.0, "Pause entries if range breaks by %", group="Filters", minval=5.0, step=1.0)
atr_avg_len     = input.int(50,    "ATR average length (above = entry allowed)", group="Filters", minval=10, maxval=200)

show_range      = input.bool(true, "Show range levels",                   group="Display")
show_bos        = input.bool(true, "Show BOS level",                      group="Display")
show_signals    = input.bool(true, "Show entry signals",                  group="Display")
show_trade_lvls = input.bool(true, "Show SL/TP on trade",                 group="Display")
show_info       = input.bool(true, "Show info table",                     group="Display")

// =============================================================================
// INSTRUMENT CONFIG
// =============================================================================
raw_ticker    = syminfo.tickerid
clean_ticker  = str.replace(str.replace(raw_ticker, ".SIM", ""), "SIM", "")
_colon_pos    = str.pos(clean_ticker, ":")
_after_colon  = _colon_pos >= 0 ? str.substring(clean_ticker, _colon_pos + 1) : clean_ticker
symbol_name   = str.replace(str.replace(_after_colon, "1!", ""), "!", "")

is_xauusd     = str.contains(raw_ticker, "XAU") or str.contains(raw_ticker, "GC")
is_usoil      = str.contains(raw_ticker, "OIL") or str.contains(raw_ticker, "WTI") or str.contains(raw_ticker, "CL")
is_us100      = str.contains(raw_ticker, "US100") or str.contains(raw_ticker, "NAS") or str.contains(raw_ticker, "NQ")
is_us30       = str.contains(raw_ticker, "US30") or str.contains(raw_ticker, "DJI") or str.contains(raw_ticker, "YM1")
is_us500      = str.contains(raw_ticker, "US500") or str.contains(raw_ticker, "SPX") or str.contains(raw_ticker, "ES")

pip_value_per_001 = is_xauusd ? 0.01 : is_usoil ? 0.10 : is_us100 ? 0.01 : 0.10
pip_size          = is_xauusd ? 0.01 : is_usoil ? 0.01 : is_us100 ? 1.0  : syminfo.mintick * 10
price_format      = is_us100  ? "#.#" : is_xauusd ? "#.##" : "#.#####"
risk_dollars      = 500.0

// =============================================================================
// ATR (5M native)
// =============================================================================
atr_now = ta.atr(14)
atr_avg = ta.sma(atr_now, atr_avg_len)
atr_ok  = atr_now > atr_avg

// =============================================================================
// 1H AUTO-RANGE — highest high and lowest low of the last N 1H bars
// This directly matches the swing high/low you see on the 1H chart, with
// no pivot-confirmation lag. Range updates when 1H structure changes.
// =============================================================================
[range_high, range_low] = request.security(
     syminfo.tickerid, "60",
     [ta.highest(high, h1_lookback),
      ta.lowest(low,   h1_lookback)],
     lookahead=barmerge.lookahead_off)

htf_range = not na(range_high) and not na(range_low) and range_high > range_low ?
     range_high - range_low : na
htf_mid   = not na(htf_range) ? (range_high + range_low) / 2 : na
zone_size = not na(htf_range) ? htf_range * (zone_pct / 100.0) : na

range_valid  = not na(range_high) and not na(range_low) and not na(htf_range)
range_broken = range_valid and (close > range_high * (1 + max_break_pct / 100.0) or close < range_low * (1 - max_break_pct / 100.0))

// =============================================================================
// ZONE DETECTION
// =============================================================================
near_high = range_valid and not na(zone_size) and math.abs(close - range_high) <= zone_size
near_low  = range_valid and not na(zone_size) and math.abs(close - range_low)  <= zone_size

var bool was_near_high = false
var bool was_near_low  = false

if near_high
    was_near_high := true
if range_valid and not na(zone_size) and close < range_high - zone_size * 3
    was_near_high := false
if near_low
    was_near_low := true
if range_valid and not na(zone_size) and close > range_low + zone_size * 3
    was_near_low := false

// Reset latch when range updates to a new high/low
var float prev_range_high = na
var float prev_range_low  = na
if range_high != prev_range_high or range_low != prev_range_low
    was_near_high  := false
    was_near_low   := false
    prev_range_high := range_high
    prev_range_low  := range_low

// =============================================================================
// BOUNDARY ROTATION GATE
// =============================================================================
var string armed_side    = "both"
var bool waiting_for_high = false
var bool waiting_for_low  = false

if use_rotation
    if waiting_for_high and near_high
        waiting_for_high := false
        armed_side       := "high"
    if waiting_for_low and near_low
        waiting_for_low  := false
        armed_side       := "low"

can_trade_high = range_valid and (not use_rotation or armed_side == "both" or armed_side == "high")
can_trade_low  = range_valid and (not use_rotation or armed_side == "both" or armed_side == "low")

// =============================================================================
// 15M BOS DETECTION
// =============================================================================
[m15_close_src, m15_ph_src, m15_pl_src] = request.security(
     syminfo.tickerid, "15",
     [close,
      ta.pivothigh(high, m15_bos_len, m15_bos_len),
      ta.pivotlow(low,   m15_bos_len, m15_bos_len)],
     lookahead=barmerge.lookahead_off)

var float last_m15_ph = na
var float last_m15_pl = na
if not na(m15_ph_src)
    last_m15_ph := m15_ph_src
if not na(m15_pl_src)
    last_m15_pl := m15_pl_src

// Debounced BOS events — only fire once per cross, only when near the relevant zone
m15_bear_raw = not na(last_m15_pl) and m15_close_src < last_m15_pl
m15_bull_raw = not na(last_m15_ph) and m15_close_src > last_m15_ph

var bool m15_bear_prev = false
var bool m15_bull_prev = false

m15_bear_event = m15_bear_raw and not m15_bear_prev and was_near_high and can_trade_high
m15_bull_event = m15_bull_raw and not m15_bull_prev and was_near_low  and can_trade_low

m15_bear_prev := m15_bear_raw
m15_bull_prev := m15_bull_raw

// =============================================================================
// BOS STATE
// =============================================================================
var float bear_bos_level  = na
var float bull_bos_level  = na
var bool  bear_bos_active = false
var bool  bull_bos_active = false
var int   bear_bos_bar    = -1
var int   bull_bos_bar    = -1
var int   bear_entry_bar  = -1
var int   bull_entry_bar  = -1

max_retrace_dist = not na(htf_range) ? htf_range * (max_retrace_pct / 100.0) : na

if m15_bear_event
    bear_bos_level  := last_m15_pl
    bear_bos_active := true
    bear_bos_bar    := bar_index
    bull_bos_active := false
    was_near_high   := false

if m15_bull_event
    bull_bos_level  := last_m15_ph
    bull_bos_active := true
    bull_bos_bar    := bar_index
    bear_bos_active := false
    was_near_low    := false

// Invalidate if range updates (new 1H structure)
if range_high != prev_range_high or range_low != prev_range_low
    bear_bos_active := false
    bull_bos_active := false

// Invalidate if price moves too far from BOS without retesting
if bear_bos_active and not na(max_retrace_dist) and not na(bear_bos_level)
    if close < bear_bos_level - max_retrace_dist
        bear_bos_active := false
if bull_bos_active and not na(max_retrace_dist) and not na(bull_bos_level)
    if close > bull_bos_level + max_retrace_dist
        bull_bos_active := false

// =============================================================================
// 5M ENTRY — REJECTION CANDLE AT BOS LEVEL
// =============================================================================
// SHORT: 5M high reaches BOS level (retest) AND 5M closes below it (rejection)
// LONG : 5M low  reaches BOS level (retest) AND 5M closes above it (bounce)
short_retracing = bear_bos_active and not na(bear_bos_level) and
     high >= bear_bos_level and close < bear_bos_level

long_retracing  = bull_bos_active and not na(bull_bos_level) and
     low <= bull_bos_level and close > bull_bos_level

// =============================================================================
// SL / TP / R:R
// =============================================================================
// SL at range boundary — trade is invalidated only if price breaks through the range extreme
short_entry = close
short_sl    = not na(range_high) ? range_high + atr_now * atr_mult : na
short_tp1   = htf_mid
short_tp2   = range_low
short_risk  = not na(short_sl) ? short_sl - short_entry : na
short_rwd1  = not na(short_tp1) ? short_entry - short_tp1 : na
short_rr1   = not na(short_risk) and short_risk > 0 ? short_rwd1 / short_risk : 0.0
short_rr_ok = short_rr1 >= min_rr

long_entry = close
long_sl    = not na(range_low) ? range_low - atr_now * atr_mult : na
long_tp1   = htf_mid
long_tp2   = range_high
long_risk  = not na(long_sl) ? long_entry - long_sl : na
long_rwd1  = not na(long_tp1) ? long_tp1 - long_entry : na
long_rr1   = not na(long_risk) and long_risk > 0 ? long_rwd1 / long_risk : 0.0
long_rr_ok = long_rr1 >= min_rr

// =============================================================================
// LOT SIZING
// =============================================================================
_lots(entry_p, sl_p) =>
    sl_pips = not na(sl_p) ? math.max(math.abs(entry_p - sl_p) / pip_size, 0.01) : 0.01
    rp001   = sl_pips * pip_value_per_001
    math.max(0.01, rp001 > 0 ? math.floor(risk_dollars / rp001) * 0.01 : 0.01)

short_lots     = _lots(short_entry, short_sl)
long_lots      = _lots(long_entry,  long_sl)
short_tp1_lots = math.max(0.01, math.floor(short_lots / 2 / 0.01) * 0.01)
long_tp1_lots  = math.max(0.01, math.floor(long_lots  / 2 / 0.01) * 0.01)

// =============================================================================
// FINAL SIGNALS
// =============================================================================
no_position  = strategy.opentrades == 0
short_signal = short_retracing and short_rr_ok and not na(short_sl) and bear_entry_bar < bear_bos_bar and no_position and not range_broken and atr_ok
long_signal  = long_retracing  and long_rr_ok  and not na(long_sl)  and bull_entry_bar < bull_bos_bar and no_position and not range_broken and atr_ok

// =============================================================================
// STRATEGY EXECUTION
// =============================================================================
if short_signal
    strategy.entry("SHORT", strategy.short, qty=short_lots,
         comment="SHORT " + str.tostring(short_lots) + "L RR:" + str.tostring(short_rr1,"#.#"))
    strategy.exit("SHORT_TP1", from_entry="SHORT", qty=short_tp1_lots,
         limit=short_tp1, stop=short_sl, comment="TP1")
    strategy.exit("SHORT_TP2", from_entry="SHORT",
         limit=short_tp2, stop=short_sl, comment="TP2+SL")
    alert('{"event":"entry_filled","account":"PAPER","symbol":"' + symbol_name +
         '","direction":"SHORT","timeframe":"5"' +
         ',"lot_size":'        + str.tostring(short_lots) +
         ',"entry_price":'     + str.tostring(short_entry,    price_format) +
         ',"stop_loss":'       + str.tostring(short_sl,       price_format) +
         ',"tp1":'             + str.tostring(short_tp1,      price_format) +
         ',"tp2":'             + str.tostring(short_tp2,      price_format) +
         ',"rr_to_tp1":'       + str.tostring(short_rr1,      "#.##") +
         ',"bos_level":'       + str.tostring(bear_bos_level, price_format) +
         ',"range_high":'      + str.tostring(range_high,     price_format) +
         ',"range_low":'       + str.tostring(range_low,      price_format) +
         ',"token":"paper_wasirizvi_wyckoffstrategy"}', alert.freq_once_per_bar_close)
    bear_entry_bar  := bar_index
    bear_bos_active := false
    if use_rotation
        waiting_for_low := true
        armed_side      := "none"

if long_signal
    strategy.entry("LONG", strategy.long, qty=long_lots,
         comment="LONG " + str.tostring(long_lots) + "L RR:" + str.tostring(long_rr1,"#.#"))
    strategy.exit("LONG_TP1", from_entry="LONG", qty=long_tp1_lots,
         limit=long_tp1, stop=long_sl, comment="TP1")
    strategy.exit("LONG_TP2", from_entry="LONG",
         limit=long_tp2, stop=long_sl, comment="TP2+SL")
    alert('{"event":"entry_filled","account":"PAPER","symbol":"' + symbol_name +
         '","direction":"LONG","timeframe":"5"' +
         ',"lot_size":'        + str.tostring(long_lots) +
         ',"entry_price":'     + str.tostring(long_entry,    price_format) +
         ',"stop_loss":'       + str.tostring(long_sl,       price_format) +
         ',"tp1":'             + str.tostring(long_tp1,      price_format) +
         ',"tp2":'             + str.tostring(long_tp2,      price_format) +
         ',"rr_to_tp1":'       + str.tostring(long_rr1,      "#.##") +
         ',"bos_level":'       + str.tostring(bull_bos_level, price_format) +
         ',"range_high":'      + str.tostring(range_high,    price_format) +
         ',"range_low":'       + str.tostring(range_low,     price_format) +
         ',"token":"paper_wasirizvi_wyckoffstrategy"}', alert.freq_once_per_bar_close)
    bull_entry_bar  := bar_index
    bull_bos_active := false
    if use_rotation
        waiting_for_high := true
        armed_side       := "none"

// =============================================================================
// TP1 → BREAKEVEN
// =============================================================================
var float entry_price_stored = na
var float be_tp2             = na

if short_signal
    entry_price_stored := short_entry
    be_tp2             := short_tp2
if long_signal
    entry_price_stored := long_entry
    be_tp2             := long_tp2

var float prev_pos = 0.0
pos_changed   = strategy.position_size != prev_pos
tp1_short_hit = prev_pos < 0 and strategy.position_size < 0 and strategy.position_size > prev_pos and pos_changed
tp1_long_hit  = prev_pos > 0 and strategy.position_size > 0 and strategy.position_size < prev_pos and pos_changed

if tp1_short_hit and not na(entry_price_stored)
    strategy.exit("SHORT_BE", from_entry="SHORT", limit=be_tp2, stop=entry_price_stored, comment="TP2 BE")
if tp1_long_hit  and not na(entry_price_stored)
    strategy.exit("LONG_BE",  from_entry="LONG",  limit=be_tp2, stop=entry_price_stored, comment="TP2 BE")

// =============================================================================
// LIFECYCLE ALERTS
// =============================================================================
_n = strategy.closedtrades - 1

tp2_short_hit = prev_pos < 0 and strategy.position_size == 0 and _n >= 0 and strategy.closedtrades.exit_price(_n) <= strategy.closedtrades.entry_price(_n)
tp2_long_hit  = prev_pos > 0 and strategy.position_size == 0 and _n >= 0 and strategy.closedtrades.exit_price(_n) >= strategy.closedtrades.entry_price(_n)
sl_short_hit  = prev_pos < 0 and strategy.position_size == 0 and _n >= 0 and strategy.closedtrades.exit_price(_n) > strategy.closedtrades.entry_price(_n)
sl_long_hit   = prev_pos > 0 and strategy.position_size == 0 and _n >= 0 and strategy.closedtrades.exit_price(_n) < strategy.closedtrades.entry_price(_n)

last_pnl        = _n >= 0 ? strategy.closedtrades.profit(_n) : 0.0
last_exit_price = _n >= 0 ? strategy.closedtrades.exit_price(_n) : close

_lc(evt, dir) =>
    alert('{"event":"' + evt + '","account":"PAPER","symbol":"' + symbol_name +
         '","direction":"' + dir +
         '","price":'  + str.tostring(last_exit_price, price_format) +
         ',"pnl":'     + str.tostring(last_pnl) +
         ',"token":"paper_wasirizvi_wyckoffstrategy"}', alert.freq_once_per_bar_close)

if tp1_short_hit
    _lc("tp1_hit", "SHORT")
if tp1_long_hit
    _lc("tp1_hit", "LONG")
if tp2_short_hit
    _lc("tp2_hit", "SHORT")
if tp2_long_hit
    _lc("tp2_hit", "LONG")
if sl_short_hit
    _lc("sl_hit", "SHORT")
    if use_rotation
        waiting_for_low := true
        armed_side      := "none"
if sl_long_hit
    _lc("sl_hit", "LONG")
    if use_rotation
        waiting_for_high := true
        armed_side       := "none"

prev_pos := strategy.position_size

// =============================================================================
// VISUALS
// =============================================================================

// Range level plots — plot() draws a flat horizontal at a fixed value; since
// range_high/low are var floats that only update on a new 1H pivot, each
// level renders as a clean flat line with no candle-structure artifacts.
plot(show_range and not na(range_high) ? range_high : na, "1H Range High", color=color.red,               linewidth=2)
plot(show_range and not na(htf_mid)   ? htf_mid    : na, "Range Mid",      color=color.new(color.gray,0), linewidth=1, style=plot.style_linebr)
plot(show_range and not na(range_low) ? range_low  : na, "1H Range Low",   color=color.green,             linewidth=2)

bgcolor(near_high ? color.new(color.red,   92) : na, title="High zone")
bgcolor(near_low  ? color.new(color.green, 92) : na, title="Low zone")

plot(show_bos and bear_bos_active ? bear_bos_level : na, "Bear BOS", color=color.new(color.orange, 0), linewidth=1, style=plot.style_linebr)
plot(show_bos and bull_bos_active ? bull_bos_level : na, "Bull BOS", color=color.new(color.blue,   0), linewidth=1, style=plot.style_linebr)

if show_bos and m15_bear_event
    label.new(bar_index, high, "15M BOS v", color=color.orange, textcolor=color.white, style=label.style_label_down, size=size.small)
if show_bos and m15_bull_event
    label.new(bar_index, low,  "15M BOS ^", color=color.blue,   textcolor=color.white, style=label.style_label_up,   size=size.small)

plotshape(show_signals and short_signal, "SHORT", shape.triangledown, location.abovebar, color.new(color.red,   0), size=size.normal)
plotshape(show_signals and long_signal,  "LONG",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.normal)

if show_signals and short_retracing and not short_signal
    label.new(bar_index, high, "RR:" + str.tostring(short_rr1,"#.#") + (short_rr_ok ? "" : "x"),
         color=short_rr_ok ? color.new(color.red,70) : color.new(color.gray,70),
         textcolor=color.white, style=label.style_label_down, size=size.tiny)
if show_signals and long_retracing and not long_signal
    label.new(bar_index, low, "RR:" + str.tostring(long_rr1,"#.#") + (long_rr_ok ? "" : "x"),
         color=long_rr_ok ? color.new(color.green,70) : color.new(color.gray,70),
         textcolor=color.white, style=label.style_label_up, size=size.tiny)

var float active_sl  = na
var float active_tp1 = na
var float active_tp2 = na
if short_signal or long_signal
    active_sl  := short_signal ? short_sl  : long_sl
    active_tp1 := short_signal ? short_tp1 : long_tp1
    active_tp2 := short_signal ? short_tp2 : long_tp2
if strategy.position_size == 0 and prev_pos != 0
    active_sl  := na
    active_tp1 := na
    active_tp2 := na

plot(show_trade_lvls and strategy.position_size != 0 and not na(active_sl)  ? active_sl  : na, "SL",  color=color.red,                  linewidth=2, style=plot.style_linebr)
plot(show_trade_lvls and strategy.position_size != 0 and not na(active_tp1) ? active_tp1 : na, "TP1", color=color.new(color.green, 30), linewidth=1, style=plot.style_linebr)
plot(show_trade_lvls and strategy.position_size != 0 and not na(active_tp2) ? active_tp2 : na, "TP2", color=color.green,                linewidth=2, style=plot.style_linebr)

// =============================================================================
// INFO TABLE
// =============================================================================
var table info = table.new(position.top_right, 2, 14, bgcolor=color.new(color.black, 70), border_width=1)
if show_info
    arm_display = not use_rotation ? "OFF" :
         armed_side == "none" ? "WAIT->" + (waiting_for_high ? "HIGH" : "LOW") :
         armed_side == "both" ? "BOTH"   : str.upper(armed_side)
    bos_state   = bear_bos_active ? "BEAR ACTIVE" : bull_bos_active ? "BULL ACTIVE" : "NONE"
    retr_state  = short_retracing ? "SHORT RETEST" : long_retracing ? "LONG RETEST" : "--"

    table.cell(info, 0, 0,  "PAPER MTF v3",                  text_color=color.white, text_size=size.normal)
    table.cell(info, 1, 0,  "1H Range | 15M BOS | 5M Entry", text_color=color.yellow)
    table.cell(info, 0, 1,  "Symbol",                         text_color=color.gray)
    table.cell(info, 1, 1,  symbol_name,                      text_color=color.white)
    table.cell(info, 0, 2,  "Range High (1H)",                text_color=color.gray)
    table.cell(info, 1, 2,  not na(range_high) ? str.tostring(range_high, price_format) : "Waiting...", text_color=color.red)
    table.cell(info, 0, 3,  "Range Mid",                      text_color=color.gray)
    table.cell(info, 1, 3,  not na(htf_mid) ? str.tostring(htf_mid, price_format) : "--",               text_color=color.white)
    table.cell(info, 0, 4,  "Range Low  (1H)",                text_color=color.gray)
    table.cell(info, 1, 4,  not na(range_low) ? str.tostring(range_low, price_format) : "Waiting...",   text_color=color.green)
    table.cell(info, 0, 5,  "Range Size",                     text_color=color.gray)
    table.cell(info, 1, 5,  not na(htf_range) ? str.tostring(htf_range, price_format) : "--",           text_color=color.gray)
    table.cell(info, 0, 6,  "At Level",                       text_color=color.gray)
    table.cell(info, 1, 6,  near_high ? "HIGH ZONE" : near_low ? "LOW ZONE" : "--",
         text_color=near_high ? color.red : near_low ? color.green : color.gray)
    table.cell(info, 0, 7,  "Armed Side",                     text_color=color.gray)
    table.cell(info, 1, 7,  arm_display,                      text_color=armed_side == "none" ? color.orange : color.green)
    table.cell(info, 0, 8,  "15M BOS State",                  text_color=color.gray)
    table.cell(info, 1, 8,  bos_state,                        text_color=bear_bos_active ? color.orange : bull_bos_active ? color.blue : color.gray)
    table.cell(info, 0, 9,  "5M Retest",                      text_color=color.gray)
    table.cell(info, 1, 9,  retr_state,                        text_color=short_retracing ? color.red : long_retracing ? color.green : color.gray)
    table.cell(info, 0, 10, "R:R",                             text_color=color.gray)
    table.cell(info, 1, 10, short_retracing ? str.tostring(short_rr1,"#.##")+":1" :
         long_retracing ? str.tostring(long_rr1,"#.##")+":1" : "--",                                    text_color=color.white)
    table.cell(info, 0, 11, "BOS Level",                      text_color=color.gray)
    table.cell(info, 1, 11, bear_bos_active and not na(bear_bos_level) ? str.tostring(bear_bos_level, price_format) :
         bull_bos_active and not na(bull_bos_level) ? str.tostring(bull_bos_level, price_format) : "--",
         text_color=bear_bos_active ? color.orange : bull_bos_active ? color.blue : color.gray)
    table.cell(info, 0, 12, "1H Lookback",                    text_color=color.gray)
    table.cell(info, 1, 12, str.tostring(h1_lookback),         text_color=color.gray)
    table.cell(info, 0, 13, "ATR Filter",                      text_color=color.gray)
    table.cell(info, 1, 13, atr_ok ? "PASS " + str.tostring(atr_now, "#.##") + " > " + str.tostring(atr_avg, "#.##") :
         "BLOCK " + str.tostring(atr_now, "#.##") + " < " + str.tostring(atr_avg, "#.##"),
         text_color=atr_ok ? color.green : color.red)
