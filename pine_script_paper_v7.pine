// =============================================================================
// PAPER TRADING — WYCKOFF RANGE REVERSAL v7
// Daily Pivot Range | 4H BOS Reversal at the Boundaries | 4H Entry
// =============================================================================
// Replaces every v5 entry model (A/B/C/D/E) with ONE setup, per user spec
// 2026-09-28. v5 is kept untouched in pine_script_paper_v5.pine for rollback.
//
// Range:
//   Range High / Low = confirmed Daily pivot high / low (non-repainting: taken
//   from the last CLOSED daily bar). Levels lock once both sides exist and only
//   reset when price closes beyond a boundary by max_break_pct of range size.
//
// Setup (both sides, mirror images):
//   TOP    : price trades into the top zone (wick within zone_pct of range high,
//            or above it) -> the highest high since entering the zone is the
//            reversal wick -> 4H close breaks BELOW the most recent confirmed 4H
//            swing low (bearish BOS, swing low must sit in the upper half of
//            the range) -> SHORT at the BOS bar's close.
//   BOTTOM : price trades into the bottom zone -> lowest low since entering is
//            the reversal wick -> 4H close breaks ABOVE the most recent 4H swing
//            high (bullish BOS, swing high in the lower half) -> LONG at close.
//
// Exits (changed 2026-10-02, user spec):
//   SL  = just beyond the reversal wick (wick extreme + ATR(14) * sl_atr_buf)
//   TP  = 1:3 RR -> full close, no partials
//   Once price reaches 1:2 RR, SL moves to 1:1 RR (locks 1R) for the rest of
//   the trade.
//
// Box Break (v5 Entry E, moved onto the Daily range 2026-09-28):
//   4H close above range high -> LONG | 4H close below range low -> SHORT.
//   SL = opposite range wall, single target at 1:1 RR, full close (E exits).
//   One break per side per range.
//
// Mid Continuation (added 2026-09-28, user spec):
//   Price comes down from the top zone, a 4H candle trades to/through 50% of
//   the range but CLOSES back above it (candle 1, arms the setup), only while
//   the top has fewer than 2 completed 4H taps. The NEXT 4H candle must pierce
//   and close above candle 1's high -> LONG at candle 2's close. Mirror image
//   from the bottom -> SHORT. Any 4H close through the mid kills the setup
//   until price revisits that boundary zone.
//   SL = beyond the lower wick of candles 1-2. TP1 1:1 (50%), TP2 1:2, SL
//   stays put after TP1. Risk 0.25% (smaller range play).
//
// Risk: 0.5% ($500 on the $100K paper account) on every position, except
// Mid Continuation at 0.25% ($250).
//
// Chart       : Load on 4H (signals are suppressed on any other timeframe)
// Webhook     : https://tradingbot-production-1e5a.up.railway.app/webhook/paper
// Token       : paper_wasirizvi_wyckoffstrategy
// =============================================================================

//@version=6
strategy(
     title             = "Paper Wyckoff v7 — Daily Range / 4H BOS Reversal",
     shorttitle        = "PAPER-v7",
     overlay           = true,
     pyramiding        = 0,
     default_qty_type  = strategy.fixed,
     default_qty_value = 0.01,
     currency          = currency.USD,
     commission_type   = strategy.commission.cash_per_contract,
     commission_value  = 0.0
 )

// =============================================================================
// INPUTS
// =============================================================================
pivot_len     = input.int(5,      "Daily Pivot Length for Range (bars each side)",   group="Range", minval=2,   maxval=20)
zone_pct      = input.float(10.0, "Boundary Zone % of Range",                         group="Range", minval=1.0, maxval=30.0, step=0.5)
max_break_pct = input.float(30.0, "Reset range if price closes beyond by % of range", group="Range", minval=5.0, step=5.0)

bos_pivot_len = input.int(3,      "4H Swing Pivot Length for BOS",                    group="Entry", minval=2,   maxval=10)
sl_atr_buf    = input.float(0.1,  "SL buffer beyond reversal wick (x ATR14)",         group="Entry", minval=0.0, step=0.05)
min_sl_pips   = input.int(15,     "Min SL Distance from Entry (pips)",                group="Entry", minval=1,   maxval=500)
tp_rr         = input.float(3.0,  "Take Profit R:R (full close)",                     group="Entry", minval=1.0, step=0.1)
lock_at_rr    = input.float(2.0,  "Move SL once price reaches R:R",                   group="Entry", minval=0.5, step=0.1)
lock_to_rr    = input.float(1.0,  "...to this R:R (locked profit)",                   group="Entry", minval=0.0, step=0.1)

exclude_disabled = input.bool(true, "Skip GBPUSD / AUDUSD / GBPJPY (disabled instruments)", group="Filters")
bb_enabled       = input.bool(true, "Enable Box Break (4H close beyond Daily range)",      group="Filters")

mc_enabled       = input.bool(true,  "Enable Mid Continuation",                              group="Mid Continuation")
mc_max_taps      = input.int(2,      "Allowed while boundary 4H taps are below",             group="Mid Continuation", minval=1, maxval=10)
mc_tp1_rr        = input.float(1.0,  "TP1 R:R (closes 50%)",                                 group="Mid Continuation", minval=0.5, step=0.1)
mc_tp2_rr        = input.float(2.0,  "TP2 R:R (closes remaining 50%)",                       group="Mid Continuation", minval=0.5, step=0.1)

show_range      = input.bool(true, "Show range levels",   group="Display")
show_signals    = input.bool(true, "Show entry signals",  group="Display")
show_trade_lvls = input.bool(true, "Show SL/TP on trade", group="Display")
show_info       = input.bool(true, "Show info table",     group="Display")
show_status     = input.bool(true, "Show status label + level tags next to price", group="Display")
table_pos_in    = input.string("Bottom Right", "Info table position", options=["Top Right", "Bottom Right", "Bottom Left", "Top Left", "Middle Right"], group="Display")
table_size_in   = input.string("Normal", "Info table text size", options=["Small", "Normal", "Large"], group="Display")

// =============================================================================
// INSTRUMENT CONFIG
// =============================================================================
raw_ticker  = syminfo.tickerid
symbol_name = str.replace(str.replace(syminfo.ticker, "1!", ""), "!", "")

is_xauusd = str.contains(raw_ticker, "XAU") or str.contains(raw_ticker, "GC")
is_usoil  = str.contains(raw_ticker, "OIL") or str.contains(raw_ticker, "WTI") or str.contains(raw_ticker, "CL")
is_us100  = str.contains(raw_ticker, "US100") or str.contains(raw_ticker, "NAS") or str.contains(raw_ticker, "NQ")
is_us500  = str.contains(raw_ticker, "US500") or str.contains(raw_ticker, "SPX") or str.contains(raw_ticker, "ES")
is_gbpusd = str.contains(raw_ticker, "GBPUSD") or syminfo.ticker == "GBPUSD"
is_audusd = str.contains(raw_ticker, "AUDUSD") or syminfo.ticker == "AUDUSD"
is_gbpjpy = str.contains(raw_ticker, "GBPJPY") or syminfo.ticker == "GBPJPY"

pip_size      = is_xauusd ? 0.01 : is_usoil ? 0.01 : is_us100 ? 1.0 : syminfo.mintick * 10
_min_sl_price = pip_size * min_sl_pips
price_format  = is_us100 ? "#.#" : is_xauusd ? "#.##" : "#.#####"

instrument_ok = not exclude_disabled or not (is_gbpusd or is_audusd or is_gbpjpy)
tf_ok         = timeframe.period == "240"

risk_dollars_eff = 500.0  // 0.5% of the $100K paper account, every instrument
risk_dollars_mc  = 250.0  // 0.25% for Mid Continuation
_nzdusd_rate     = request.security("OANDA:NZDUSD", timeframe.period, close, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
_quote_to_usd    = syminfo.currency == "JPY" ? 1.0 / close : syminfo.currency == "NZD" ? _nzdusd_rate : 1.0

atr_now = ta.atr(14)

// =============================================================================
// DAILY PIVOT-ANCHORED RANGE
// expr[1] + lookahead_on = value from the last CLOSED daily bar, so the range
// never repaints intraday.
// =============================================================================
_d_ph = request.security(syminfo.tickerid, "D", ta.pivothigh(high, pivot_len, pivot_len)[1], lookahead=barmerge.lookahead_on)
_d_pl = request.security(syminfo.tickerid, "D", ta.pivotlow(low,  pivot_len, pivot_len)[1],  lookahead=barmerge.lookahead_on)

var float range_high   = na
var float range_low    = na
var bool  range_locked = false

if not range_locked
    if not na(_d_ph)
        range_high := na(range_high) ? _d_ph : math.max(range_high, _d_ph)
    if not na(_d_pl)
        range_low  := na(range_low)  ? _d_pl : math.min(range_low,  _d_pl)
    if not na(range_high) and not na(range_low) and range_high > range_low
        range_locked := true

range_valid = range_locked and not na(range_high) and not na(range_low) and range_high > range_low
range_size  = range_valid ? range_high - range_low : na
range_mid   = range_valid ? (range_high + range_low) / 2 : na
zone_size   = range_valid ? range_size * (zone_pct / 100.0) : na

range_broken = range_valid and
     (close > range_high + range_size * (max_break_pct / 100.0) or
      close < range_low  - range_size * (max_break_pct / 100.0))

// =============================================================================
// 4H SWING STRUCTURE
// =============================================================================
_ph4 = ta.pivothigh(high, bos_pivot_len, bos_pivot_len)
_pl4 = ta.pivotlow(low,   bos_pivot_len, bos_pivot_len)

var float last_ph = na
var float last_pl = na
if not na(_ph4)
    last_ph := _ph4
if not na(_pl4)
    last_pl := _pl4

// =============================================================================
// ZONE STATE — reversal wick tracking
// A side goes active when price wicks into its zone and stays active until a
// signal fires, price closes back through the mid, or the range resets.
// =============================================================================
in_top_zone = range_valid and high >= range_high - zone_size
in_bot_zone = range_valid and low  <= range_low  + zone_size

var bool  top_active  = false
var float top_extreme = na    // reversal wick high (SL anchor for shorts)
var bool  bot_active  = false
var float bot_extreme = na    // reversal wick low  (SL anchor for longs)

if in_top_zone
    top_extreme := top_active ? math.max(top_extreme, high) : high
    top_active  := true
if in_bot_zone
    bot_extreme := bot_active ? math.min(bot_extreme, low) : low
    bot_active  := true

// 4H taps per boundary: each separate 4H visit into the zone counts once.
// last_zone = which boundary price most recently came from (Mid Continuation).
var int    top_taps  = 0
var int    bot_taps  = 0
var string last_zone = "none"
if in_top_zone and not in_top_zone[1]
    top_taps += 1
if in_bot_zone and not in_bot_zone[1]
    bot_taps += 1
if in_top_zone
    last_zone := "top"
if in_bot_zone
    last_zone := "bottom"

// =============================================================================
// BOS DETECTION
//   Bear: 4H close crosses below the latest confirmed 4H swing low, which sits
//         in the upper half of the range, while the top side is active.
//   Bull: 4H close crosses above the latest confirmed 4H swing high, which sits
//         in the lower half of the range, while the bottom side is active.
// =============================================================================
no_position = strategy.opentrades == 0

bear_bos = top_active and not na(last_pl) and last_pl > range_mid and
     close < last_pl and close[1] >= last_pl
bull_bos = bot_active and not na(last_ph) and last_ph < range_mid and
     close > last_ph and close[1] <= last_ph

// =============================================================================
// SL / TP
// =============================================================================
short_entry = close
short_sl    = not na(top_extreme) ? math.max(top_extreme + atr_now * sl_atr_buf, short_entry + _min_sl_price) : na
short_risk  = not na(short_sl) ? short_sl - short_entry : na
short_tp    = not na(short_risk) ? short_entry - short_risk * tp_rr : na

long_entry = close
long_sl    = not na(bot_extreme) ? math.min(bot_extreme - atr_now * sl_atr_buf, long_entry - _min_sl_price) : na
long_risk  = not na(long_sl) ? long_entry - long_sl : na
long_tp    = not na(long_risk) ? long_entry + long_risk * tp_rr : na

_size(entry_p, sl_p, risk_usd) =>
    sl_dist = not na(sl_p) ? math.max(math.abs(entry_p - sl_p), syminfo.mintick) : syminfo.mintick
    math.max(0.01, math.round(risk_usd / (sl_dist * syminfo.pointvalue * _quote_to_usd), 2))

_tp1q(sz) => math.max(0.01, math.round(sz * 0.50, 2))

short_lots     = _size(short_entry, short_sl, risk_dollars_eff)
long_lots      = _size(long_entry,  long_sl,  risk_dollars_eff)

// =============================================================================
// FINAL SIGNALS
// =============================================================================
_base_ok = tf_ok and instrument_ok and no_position and range_valid and not range_broken

short_signal = bear_bos and _base_ok and not na(short_risk) and short_risk > 0
long_signal  = bull_bos and _base_ok and not na(long_risk)  and long_risk  > 0 and not short_signal

// =============================================================================
// BOX BREAK — 4H close beyond the Daily range, E exits (SL opposite wall, 1:1)
// =============================================================================
var bool bb_long_done  = false
var bool bb_short_done = false

bb_long_entry  = close
bb_long_sl     = range_low
bb_long_risk   = range_valid ? bb_long_entry - bb_long_sl : na
bb_long_tp1    = not na(bb_long_risk) and bb_long_risk > 0 ? bb_long_entry + bb_long_risk : na

bb_short_entry = close
bb_short_sl    = range_high
bb_short_risk  = range_valid ? bb_short_sl - bb_short_entry : na
bb_short_tp1   = not na(bb_short_risk) and bb_short_risk > 0 ? bb_short_entry - bb_short_risk : na

_bb_ok = bb_enabled and _base_ok and not short_signal and not long_signal
long_signal_bb  = _bb_ok and not bb_long_done  and close > range_high and close[1] <= range_high and not na(bb_long_tp1)
short_signal_bb = _bb_ok and not bb_short_done and close < range_low  and close[1] >= range_low  and not na(bb_short_tp1)

// =============================================================================
// MID CONTINUATION — failed close through 50% (candle 1), confirmed by the
// next 4H candle piercing and closing beyond candle 1 (candle 2 = entry)
// =============================================================================
// Candle 1 of the previous bar, stored at the end of that bar's evaluation.
var float mc_l_c1_high = na
var float mc_l_c1_low  = na
var int   mc_l_c1_bar  = -1
var float mc_s_c1_high = na
var float mc_s_c1_low  = na
var int   mc_s_c1_bar  = -1

mc_long_confirm  = mc_l_c1_bar == bar_index - 1 and close > mc_l_c1_high
mc_short_confirm = mc_s_c1_bar == bar_index - 1 and close < mc_s_c1_low

mc_long_entry  = close
mc_long_sl     = mc_long_confirm ? math.min(math.min(mc_l_c1_low, low) - atr_now * sl_atr_buf, mc_long_entry - _min_sl_price) : na
mc_long_risk   = not na(mc_long_sl) ? mc_long_entry - mc_long_sl : na
mc_long_tp1    = not na(mc_long_risk) ? mc_long_entry + mc_long_risk * mc_tp1_rr : na
mc_long_tp2    = not na(mc_long_risk) ? mc_long_entry + mc_long_risk * mc_tp2_rr : na

mc_short_entry = close
mc_short_sl    = mc_short_confirm ? math.max(math.max(mc_s_c1_high, high) + atr_now * sl_atr_buf, mc_short_entry + _min_sl_price) : na
mc_short_risk  = not na(mc_short_sl) ? mc_short_sl - mc_short_entry : na
mc_short_tp1   = not na(mc_short_risk) ? mc_short_entry - mc_short_risk * mc_tp1_rr : na
mc_short_tp2   = not na(mc_short_risk) ? mc_short_entry - mc_short_risk * mc_tp2_rr : na

_mc_ok = mc_enabled and _base_ok and not short_signal and not long_signal and not long_signal_bb and not short_signal_bb
long_signal_mc  = _mc_ok and mc_long_confirm  and not na(mc_long_risk)  and mc_long_risk  > 0
short_signal_mc = _mc_ok and mc_short_confirm and not na(mc_short_risk) and mc_short_risk > 0 and not long_signal_mc

// Candle 1 (setup) on THIS bar — checked for confirmation on the next bar.
mc_long_setup  = mc_enabled and range_valid and last_zone == "top"    and top_taps < mc_max_taps and low  <= range_mid and close > range_mid
mc_short_setup = mc_enabled and range_valid and last_zone == "bottom" and bot_taps < mc_max_taps and high >= range_mid and close < range_mid

// =============================================================================
// STRATEGY EXECUTION
// =============================================================================
var bool   _entry_alert_pending = false
var string _entry_alert_msg     = ""
var float  s_entry = na
var float  s_sl    = na
var float  s_tp1   = na
var float  s_tp2   = na
var float  s_risk  = na        // R in price terms (range reversal SL lock)
var int    s_bar   = -1        // signal bar
var string s_setup = ""        // "rev", "bb", "mc"
var bool   lock_done = false   // range reversal SL already moved to lock_to_rr

// Single full target: "tp1" carries the 1:3 TP and no "tp2" is sent (same
// single-target shape as box_break). sl_lock_* are informational.
_entry_msg(dir, lots, entry, sl, tp, lock_trig, lock_to, bos) =>
    '{"event":"entry_filled","account":"PAPER","symbol":"' + symbol_name +
         '","direction":"' + dir + '","setup":"range_rev","timeframe":"240"' +
         ',"lot_size":'    + str.tostring(lots) +
         ',"entry_price":' + str.tostring(entry, price_format) +
         ',"stop_loss":'   + str.tostring(sl,    price_format) +
         ',"tp1":'         + str.tostring(tp,    price_format) +
         ',"rr_to_tp1":'   + str.tostring(tp_rr) +
         ',"sl_lock_trigger":' + str.tostring(lock_trig, price_format) +
         ',"sl_lock_to":'  + str.tostring(lock_to, price_format) +
         ',"bos_level":'   + str.tostring(bos,        price_format) +
         ',"range_high":'  + str.tostring(range_high, price_format) +
         ',"range_low":'   + str.tostring(range_low,  price_format) +
         ',"token":"paper_wasirizvi_wyckoffstrategy"}'

if short_signal
    strategy.entry("SHORT", strategy.short, qty=short_lots, comment="SHORT " + str.tostring(short_lots) + "L")
    strategy.exit("SHORT_X", from_entry="SHORT", limit=short_tp, stop=short_sl, comment="TP 1:" + str.tostring(tp_rr))
    s_entry := short_entry
    s_sl    := short_sl
    s_tp1   := short_tp
    s_tp2   := na
    s_risk  := short_risk
    s_bar   := bar_index
    s_setup := "rev"
    lock_done := false
    _entry_alert_pending := true
    _entry_alert_msg     := _entry_msg("SHORT", short_lots, short_entry, short_sl, short_tp,
         short_entry - short_risk * lock_at_rr, short_entry - short_risk * lock_to_rr, last_pl)

if long_signal
    strategy.entry("LONG", strategy.long, qty=long_lots, comment="LONG " + str.tostring(long_lots) + "L")
    strategy.exit("LONG_X", from_entry="LONG", limit=long_tp, stop=long_sl, comment="TP 1:" + str.tostring(tp_rr))
    s_entry := long_entry
    s_sl    := long_sl
    s_tp1   := long_tp
    s_tp2   := na
    s_risk  := long_risk
    s_bar   := bar_index
    s_setup := "rev"
    lock_done := false
    _entry_alert_pending := true
    _entry_alert_msg     := _entry_msg("LONG", long_lots, long_entry, long_sl, long_tp,
         long_entry + long_risk * lock_at_rr, long_entry + long_risk * lock_to_rr, last_ph)

_bb_msg(dir, lots, entry, sl, tp1) =>
    '{"event":"entry_filled","account":"PAPER","symbol":"' + symbol_name +
         '","direction":"' + dir + '","setup":"box_break","timeframe":"240"' +
         ',"lot_size":'    + str.tostring(lots) +
         ',"entry_price":' + str.tostring(entry, price_format) +
         ',"stop_loss":'   + str.tostring(sl,    price_format) +
         ',"tp1":'         + str.tostring(tp1,   price_format) +
         ',"box_high":'    + str.tostring(range_high, price_format) +
         ',"box_low":'     + str.tostring(range_low,  price_format) +
         ',"token":"paper_wasirizvi_wyckoffstrategy"}'

if long_signal_bb
    _bb_lots = _size(bb_long_entry, bb_long_sl, risk_dollars_eff)
    strategy.entry("LONG_BB", strategy.long, qty=_bb_lots, comment="LONG_BB " + str.tostring(_bb_lots) + "L")
    strategy.exit("LONG_BB_TP1", from_entry="LONG_BB", limit=bb_long_tp1, stop=bb_long_sl, comment="TP1 1:1")
    s_entry := bb_long_entry
    s_sl    := bb_long_sl
    s_tp1   := bb_long_tp1
    s_tp2   := na
    s_setup := "bb"
    bb_long_done := true
    _entry_alert_pending := true
    _entry_alert_msg     := _bb_msg("LONG", _bb_lots, bb_long_entry, bb_long_sl, bb_long_tp1)

if short_signal_bb
    _bb_lots = _size(bb_short_entry, bb_short_sl, risk_dollars_eff)
    strategy.entry("SHORT_BB", strategy.short, qty=_bb_lots, comment="SHORT_BB " + str.tostring(_bb_lots) + "L")
    strategy.exit("SHORT_BB_TP1", from_entry="SHORT_BB", limit=bb_short_tp1, stop=bb_short_sl, comment="TP1 1:1")
    s_entry := bb_short_entry
    s_sl    := bb_short_sl
    s_tp1   := bb_short_tp1
    s_tp2   := na
    s_setup := "bb"
    bb_short_done := true
    _entry_alert_pending := true
    _entry_alert_msg     := _bb_msg("SHORT", _bb_lots, bb_short_entry, bb_short_sl, bb_short_tp1)

_mc_msg(dir, lots, entry, sl, tp1, tp2) =>
    '{"event":"entry_filled","account":"PAPER","symbol":"' + symbol_name +
         '","direction":"' + dir + '","setup":"mid_cont","timeframe":"240"' +
         ',"lot_size":'    + str.tostring(lots) +
         ',"entry_price":' + str.tostring(entry, price_format) +
         ',"stop_loss":'   + str.tostring(sl,    price_format) +
         ',"tp1":'         + str.tostring(tp1,   price_format) +
         ',"tp2":'         + str.tostring(tp2,   price_format) +
         ',"rr_to_tp1":'   + str.tostring(mc_tp1_rr) +
         ',"range_high":'  + str.tostring(range_high, price_format) +
         ',"range_low":'   + str.tostring(range_low,  price_format) +
         ',"token":"paper_wasirizvi_wyckoffstrategy"}'

if long_signal_mc
    _mc_lots = _size(mc_long_entry, mc_long_sl, risk_dollars_mc)
    strategy.entry("LONG_MC", strategy.long, qty=_mc_lots, comment="LONG_MC " + str.tostring(_mc_lots) + "L")
    strategy.exit("LONG_MC_TP1", from_entry="LONG_MC", qty=_tp1q(_mc_lots), limit=mc_long_tp1, stop=mc_long_sl, comment="TP1 1:" + str.tostring(mc_tp1_rr))
    strategy.exit("LONG_MC_TP2", from_entry="LONG_MC", limit=mc_long_tp2, stop=mc_long_sl, comment="TP2 1:" + str.tostring(mc_tp2_rr))
    s_entry := mc_long_entry
    s_sl    := mc_long_sl
    s_tp1   := mc_long_tp1
    s_tp2   := mc_long_tp2
    s_setup := "mc"
    _entry_alert_pending := true
    _entry_alert_msg     := _mc_msg("LONG", _mc_lots, mc_long_entry, mc_long_sl, mc_long_tp1, mc_long_tp2)

if short_signal_mc
    _mc_lots = _size(mc_short_entry, mc_short_sl, risk_dollars_mc)
    strategy.entry("SHORT_MC", strategy.short, qty=_mc_lots, comment="SHORT_MC " + str.tostring(_mc_lots) + "L")
    strategy.exit("SHORT_MC_TP1", from_entry="SHORT_MC", qty=_tp1q(_mc_lots), limit=mc_short_tp1, stop=mc_short_sl, comment="TP1 1:" + str.tostring(mc_tp1_rr))
    strategy.exit("SHORT_MC_TP2", from_entry="SHORT_MC", limit=mc_short_tp2, stop=mc_short_sl, comment="TP2 1:" + str.tostring(mc_tp2_rr))
    s_entry := mc_short_entry
    s_sl    := mc_short_sl
    s_tp1   := mc_short_tp1
    s_tp2   := mc_short_tp2
    s_setup := "mc"
    _entry_alert_pending := true
    _entry_alert_msg     := _mc_msg("SHORT", _mc_lots, mc_short_entry, mc_short_sl, mc_short_tp1, mc_short_tp2)

// Mid Continuation state. Store this bar as candle 1 if it armed (and no
// entry fired on it); one trade per visit to a boundary; a 4H close through
// the mid means the continuation failed until the boundary is revisited.
mc_l_c1_bar := -1
mc_s_c1_bar := -1
if mc_long_setup and not long_signal_mc and not short_signal_mc
    mc_l_c1_high := high
    mc_l_c1_low  := low
    mc_l_c1_bar  := bar_index
if mc_short_setup and not long_signal_mc and not short_signal_mc
    mc_s_c1_high := high
    mc_s_c1_low  := low
    mc_s_c1_bar  := bar_index
if long_signal_mc or (last_zone == "top" and range_valid and close < range_mid)
    last_zone := "none"
if short_signal_mc or (last_zone == "bottom" and range_valid and close > range_mid)
    last_zone := "none"

// Zone state resets: after a signal on that side, when price closes back
// through the mid without a BOS, or when the range resets.
if short_signal or (range_valid and close < range_mid)
    top_active  := false
    top_extreme := na
if long_signal or (range_valid and close > range_mid)
    bot_active  := false
    bot_extreme := na

if range_broken
    range_high   := na
    range_low    := na
    range_locked := false
    top_active   := false
    top_extreme  := na
    bot_active   := false
    bot_extreme  := na
    bb_long_done  := false
    bb_short_done := false
    top_taps      := 0
    bot_taps      := 0
    last_zone     := "none"

// =============================================================================
// RANGE REVERSAL SL LOCK — once price reaches lock_at_rr (1:2), move the stop
// to lock_to_rr (1:1). Target stays at tp_rr (1:3).
// =============================================================================
if s_setup == "rev" and strategy.position_size != 0 and not lock_done and bar_index > s_bar and not na(s_risk) and s_risk > 0
    _is_short = strategy.position_size < 0
    _fav_rr   = _is_short ? (s_entry - low) / s_risk : (high - s_entry) / s_risk
    if _fav_rr >= lock_at_rr
        lock_done := true
        s_sl      := _is_short ? s_entry - s_risk * lock_to_rr : s_entry + s_risk * lock_to_rr
        strategy.exit(_is_short ? "SHORT_X" : "LONG_X", from_entry=_is_short ? "SHORT" : "LONG",
             limit=s_tp1, stop=s_sl, comment="TP 1:" + str.tostring(tp_rr) + " | SL locked 1:" + str.tostring(lock_to_rr))

// =============================================================================
// LIFECYCLE ALERTS
// =============================================================================
var float prev_pos = 0.0
var bool  tp1_hit  = false

_n              = strategy.closedtrades - 1
last_pnl        = _n >= 0 ? strategy.closedtrades.profit(_n) : 0.0
last_exit_price = _n >= 0 ? strategy.closedtrades.exit_price(_n) : close

if short_signal or long_signal or long_signal_bb or short_signal_bb or long_signal_mc or short_signal_mc
    tp1_hit := false

tp1_short_hit = prev_pos < 0 and strategy.position_size < 0 and strategy.position_size > prev_pos and not tp1_hit
tp1_long_hit  = prev_pos > 0 and strategy.position_size > 0 and strategy.position_size < prev_pos and not tp1_hit
if tp1_short_hit or tp1_long_hit
    tp1_hit := true

_closed_now     = prev_pos != 0 and strategy.position_size == 0 and _n >= 0
tp2_close_short = _closed_now and prev_pos < 0 and strategy.closedtrades.exit_price(_n) <  strategy.closedtrades.entry_price(_n)
tp2_close_long  = _closed_now and prev_pos > 0 and strategy.closedtrades.exit_price(_n) >  strategy.closedtrades.entry_price(_n)
sl_short_hit    = _closed_now and prev_pos < 0 and strategy.closedtrades.exit_price(_n) >= strategy.closedtrades.entry_price(_n)
sl_long_hit     = _closed_now and prev_pos > 0 and strategy.closedtrades.exit_price(_n) <= strategy.closedtrades.entry_price(_n)

_lc(evt, dir) =>
    alert('{"event":"' + evt + '","account":"PAPER","symbol":"' + symbol_name +
             '","direction":"' + dir +
             '","price":'  + str.tostring(last_exit_price, price_format) +
             ',"pnl":'     + str.tostring(last_pnl) +
             ',"token":"paper_wasirizvi_wyckoffstrategy"}', alert.freq_once_per_bar_close)

if tp1_short_hit
    _lc("tp1_hit", "SHORT")
if tp1_long_hit
    _lc("tp1_hit", "LONG")
// A range reversal closed in profit but short of its 1:3 target was stopped at
// the locked 1:1 -> reported as tp1_hit (a 1R win); a full target hit is tp2_hit.
_rev_lock_exit = s_setup == "rev" and lock_done and _closed_now and
     (prev_pos < 0 ? strategy.closedtrades.exit_price(_n) > s_tp1 + syminfo.mintick :
                     strategy.closedtrades.exit_price(_n) < s_tp1 - syminfo.mintick)
if tp2_close_short
    _lc(_rev_lock_exit ? "tp1_hit" : "tp2_hit", "SHORT")
if tp2_close_long
    _lc(_rev_lock_exit ? "tp1_hit" : "tp2_hit", "LONG")
if sl_short_hit
    _lc("sl_hit", "SHORT")
if sl_long_hit
    _lc("sl_hit", "LONG")

// Entry alert goes out after any lifecycle alert from the same bar, so the
// server closes the old trade before it sees the new one.
if _entry_alert_pending
    alert(_entry_alert_msg, alert.freq_once_per_bar_close)
if barstate.isconfirmed
    _entry_alert_pending := false

prev_pos := strategy.position_size

// =============================================================================
// VISUALS
// =============================================================================
plot(show_range and range_valid ? range_high : na, "Daily Range High", color=color.red,                linewidth=2, style=plot.style_linebr)
plot(show_range and range_valid ? range_mid  : na, "Range Mid",        color=color.gray,               linewidth=1, style=plot.style_linebr)
plot(show_range and range_valid ? range_low  : na, "Daily Range Low",  color=color.green,              linewidth=2, style=plot.style_linebr)
plot(show_range and range_valid ? range_high - zone_size : na, "Top Zone",    color=color.new(color.red,   60), linewidth=1, style=plot.style_linebr)
plot(show_range and range_valid ? range_low  + zone_size : na, "Bottom Zone", color=color.new(color.green, 60), linewidth=1, style=plot.style_linebr)

bgcolor(top_active ? color.new(color.red,   92) : na, title="Top side active")
bgcolor(bot_active ? color.new(color.green, 92) : na, title="Bottom side active")

plotshape(show_signals and short_signal, "SHORT", shape.triangledown, location.abovebar, color.orange, size=size.normal)
plotshape(show_signals and long_signal,  "LONG",  shape.triangleup,   location.belowbar, color.aqua,   size=size.normal)

if show_signals and short_signal
    label.new(bar_index, high, "4H BOS ↓ " + str.tostring(last_pl, price_format) + " | TP 1:" + str.tostring(tp_rr) + ", SL to 1:" + str.tostring(lock_to_rr) + " at 1:" + str.tostring(lock_at_rr),
         color=color.new(color.orange, 30), textcolor=color.white, style=label.style_label_down, size=size.small)
if show_signals and long_signal
    label.new(bar_index, low, "4H BOS ↑ " + str.tostring(last_ph, price_format) + " | TP 1:" + str.tostring(tp_rr) + ", SL to 1:" + str.tostring(lock_to_rr) + " at 1:" + str.tostring(lock_at_rr),
         color=color.new(color.aqua, 30), textcolor=color.white, style=label.style_label_up, size=size.small)

plotshape(show_signals and short_signal_bb, "SHORT_BB", shape.triangledown, location.abovebar, color.fuchsia, size=size.normal)
plotshape(show_signals and long_signal_bb,  "LONG_BB",  shape.triangleup,   location.belowbar, color.fuchsia, size=size.normal)

if show_signals and short_signal_bb
    label.new(bar_index, high, "BOX BREAK ↓ | TP 1:1", color=color.new(color.fuchsia, 30), textcolor=color.white, style=label.style_label_down, size=size.small)
if show_signals and long_signal_bb
    label.new(bar_index, low,  "BOX BREAK ↑ | TP 1:1", color=color.new(color.fuchsia, 30), textcolor=color.white, style=label.style_label_up,   size=size.small)

plotshape(show_signals and short_signal_mc, "SHORT_MC", shape.triangledown, location.abovebar, color.yellow, size=size.small)
plotshape(show_signals and long_signal_mc,  "LONG_MC",  shape.triangleup,   location.belowbar, color.yellow, size=size.small)

if show_signals and short_signal_mc
    label.new(bar_index, high, "MID CONT ↓ | TP1 1:1 TP2 1:2 | 0.25%", color=color.new(color.yellow, 30), textcolor=color.black, style=label.style_label_down, size=size.small)
if show_signals and long_signal_mc
    label.new(bar_index, low,  "MID CONT ↑ | TP1 1:1 TP2 1:2 | 0.25%", color=color.new(color.yellow, 30), textcolor=color.black, style=label.style_label_up, size=size.small)

in_trade = strategy.position_size != 0
plot(show_trade_lvls and in_trade ? s_entry : na, "Entry", color=color.white,               style=plot.style_linebr)
plot(show_trade_lvls and in_trade ? s_sl    : na, "SL",    color=color.red,                 style=plot.style_linebr, linewidth=2)
plot(show_trade_lvls and in_trade ? s_tp1   : na, "TP1",   color=color.new(color.green, 50), style=plot.style_linebr)
plot(show_trade_lvls and in_trade ? s_tp2   : na, "TP2",   color=color.green,               style=plot.style_linebr, linewidth=2)

if show_signals and (tp1_short_hit or tp1_long_hit)
    label.new(bar_index, last_exit_price, "TP1 50%", color=color.new(color.green, 40), textcolor=color.white, size=size.small)
if show_signals and (tp2_close_short or tp2_close_long)
    label.new(bar_index, last_exit_price, "TP2", color=color.lime, textcolor=color.black, size=size.small)
if show_signals and (sl_short_hit or sl_long_hit)
    label.new(bar_index, last_exit_price, "SL", color=color.red, textcolor=color.white, size=size.small)

// =============================================================================
// STATUS — what v7 is doing right now, in plain words (label next to price)
// =============================================================================
_fmt(v) => na(v) ? "--" : str.tostring(v, price_format)

status_txt = not tf_ok ? "WRONG TIMEFRAME: load on 4H" :
     not instrument_ok ? "INSTRUMENT DISABLED" :
     not range_valid ? "BUILDING RANGE: waiting for Daily pivot high + low" :
     in_trade ? (strategy.position_size > 0 ? "IN TRADE: LONG" : "IN TRADE: SHORT") + (tp1_hit ? " (TP1 hit)" : "") +
         (s_setup == "rev" and lock_done ? " | SL locked at 1:" + str.tostring(lock_to_rr) + " " + _fmt(s_sl) : "") :
     mc_l_c1_bar == bar_index ? "MID CONT LONG ARMED: next 4H close > " + _fmt(mc_l_c1_high) :
     mc_s_c1_bar == bar_index ? "MID CONT SHORT ARMED: next 4H close < " + _fmt(mc_s_c1_low) :
     top_active ? (not na(last_pl) and last_pl > range_mid ? "TOP ACTIVE: short on 4H close < " + _fmt(last_pl) + " (BOS)" :
                   "TOP ACTIVE: waiting for a 4H swing low in the upper half") :
     bot_active ? (not na(last_ph) and last_ph < range_mid ? "BOTTOM ACTIVE: long on 4H close > " + _fmt(last_ph) + " (BOS)" :
                   "BOTTOM ACTIVE: waiting for a 4H swing high in the lower half") :
     "WAITING: mid-range. Reversal needs a zone tap; box break needs 4H close beyond " + _fmt(range_high) + " / " + _fmt(range_low)
status_clr = not tf_ok or not instrument_ok ? color.red : not range_valid ? color.gray : in_trade ? color.yellow :
     (mc_l_c1_bar == bar_index or mc_s_c1_bar == bar_index) ? color.yellow : top_active ? color.orange : bot_active ? color.aqua : color.gray

var label lbl_status = na
var label lbl_hi     = na
var label lbl_mid    = na
var label lbl_lo     = na
if barstate.islast
    label.delete(lbl_status)
    label.delete(lbl_hi)
    label.delete(lbl_mid)
    label.delete(lbl_lo)
    if show_status
        lbl_status := label.new(bar_index + 2, close, "v7 " + status_txt, style=label.style_label_left,
             color=color.new(status_clr, 15), textcolor=color.black, size=size.normal)
        if range_valid
            lbl_hi  := label.new(bar_index + 2, range_high, "Range High " + _fmt(range_high), style=label.style_label_left, color=color.new(color.red, 30),   textcolor=color.white, size=size.small)
            lbl_mid := label.new(bar_index + 2, range_mid,  "Mid "        + _fmt(range_mid),  style=label.style_label_left, color=color.new(color.gray, 30),  textcolor=color.white, size=size.small)
            lbl_lo  := label.new(bar_index + 2, range_low,  "Range Low "  + _fmt(range_low),  style=label.style_label_left, color=color.new(color.green, 30), textcolor=color.white, size=size.small)

// =============================================================================
// INFO TABLE
// =============================================================================
_tpos  = table_pos_in == "Top Right" ? position.top_right : table_pos_in == "Bottom Left" ? position.bottom_left :
     table_pos_in == "Top Left" ? position.top_left : table_pos_in == "Middle Right" ? position.middle_right : position.bottom_right
_tsize = table_size_in == "Small" ? size.small : table_size_in == "Large" ? size.large : size.normal
var table info = table.new(_tpos, 2, 12, bgcolor=color.new(color.black, 20), border_width=1)
if show_info and barstate.islast
    table.cell(info, 0, 11, "Status",   text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 11, status_txt, text_color=status_clr, text_size=_tsize)
    table.cell(info, 0, 0, "PAPER v7",  text_color=color.white, text_size=_tsize)
    table.cell(info, 1, 0, "Daily Range | 4H BOS Reversal", text_color=color.yellow, text_size=_tsize)
    table.cell(info, 0, 1, "Timeframe", text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 1, tf_ok ? "4H OK" : "WRONG TF — load on 4H", text_color=tf_ok ? color.green : color.red, text_size=_tsize)
    table.cell(info, 0, 2, "Symbol",    text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 2, symbol_name + (instrument_ok ? "" : " (DISABLED)"), text_color=instrument_ok ? color.white : color.red, text_size=_tsize)
    table.cell(info, 0, 3, "Range High", text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 3, range_valid ? str.tostring(range_high, price_format) : "Building...", text_color=color.red, text_size=_tsize)
    table.cell(info, 0, 4, "Range Low",  text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 4, range_valid ? str.tostring(range_low, price_format) : "Building...", text_color=color.green, text_size=_tsize)
    table.cell(info, 0, 5, "Top side",   text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 5, top_active ? "ACTIVE — wick " + str.tostring(top_extreme, price_format) + " | BOS < " + str.tostring(last_pl, price_format) : "--",
         text_color=top_active ? color.orange : color.gray, text_size=_tsize)
    table.cell(info, 0, 6, "Bottom side", text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 6, bot_active ? "ACTIVE — wick " + str.tostring(bot_extreme, price_format) + " | BOS > " + str.tostring(last_ph, price_format) : "--",
         text_color=bot_active ? color.aqua : color.gray, text_size=_tsize)
    table.cell(info, 0, 7, "Exits",      text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 7, "REV: SL wick, TP 1:" + str.tostring(tp_rr) + ", SL to 1:" + str.tostring(lock_to_rr) + " at 1:" + str.tostring(lock_at_rr) + " | BB: SL opp. wall, TP 1:1" + (bb_enabled ? "" : " (OFF)"), text_color=color.gray, text_size=_tsize)
    table.cell(info, 0, 8, "Risk",       text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 8, "$" + str.tostring(risk_dollars_eff, "#") + " | Mid Cont $" + str.tostring(risk_dollars_mc, "#"), text_color=color.gray, text_size=_tsize)
    table.cell(info, 0, 10, "4H Taps",   text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 10, "Top " + str.tostring(top_taps) + " / Bottom " + str.tostring(bot_taps) + " | from: " + last_zone, text_color=color.gray, text_size=_tsize)
    table.cell(info, 0, 9, "Position",   text_color=color.gray, text_size=_tsize)
    table.cell(info, 1, 9, in_trade ? (strategy.position_size > 0 ? "LONG" : "SHORT") + (tp1_hit ? " (TP1 hit)" : "") + (s_setup == "rev" and lock_done ? " | SL locked" : "") : "FLAT",
         text_color=in_trade ? color.yellow : color.gray, text_size=_tsize)
