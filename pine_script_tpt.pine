// =============================================================================
// PINE SCRIPT — TPT 5M WYCKOFF BOS MASTER STRATEGY
// =============================================================================
// Strategy : Wyckoff range trading — BOS reversal entries
// Symbols  : MNQ1! | MCL1! | MGC1! (auto-detected)
// Timeframe: 5 minutes
// Account  : Take Profit Trader → Tradovate → TradingView Desktop
//
// Logic:
//   1. Detect a valid trading range (high/low touched 2+ times, mid touched 2+)
//   2. Detect BOS — 2 consecutive 5m closes beyond range boundary
//   3. Entry on reversal back into range after BOS
//   4. SL beyond BOS extreme wick
//   5. TP1 = range midpoint | TP2 = opposite range boundary
//   6. R:R >= 1:2 required | >= 1:3 = full close at TP1
//
// Sessions (CT):
//   London   : 01:00 — 04:00 (UTC 07:00-10:00)
//   NY       : 08:00 — 11:00 (UTC 14:00-17:00)
//   No-trade : 15:00 — 17:00 CT
//   Hard kill: 14:55 CT
//
// Execution: Webhook alert only — Python server handles Claude validation
// =============================================================================

//@version=5
indicator(title="TPT 5m Wyckoff BOS — Master", shorttitle="TPT-MASTER", overlay=true)

// -----------------------------------------------------------------------------
// SYMBOL AUTO-DETECTION
// -----------------------------------------------------------------------------
is_mnq = str.contains(syminfo.tickerid, "MNQ")
is_mcl = str.contains(syminfo.tickerid, "MCL")
is_mgc = str.contains(syminfo.tickerid, "MGC")

// Warn if unsupported symbol
unsupported = not is_mnq and not is_mcl and not is_mgc
var label unsupported_label = na
if unsupported and barstate.islast
    unsupported_label := label.new(bar_index, high, "⚠️ Unsupported symbol.\nLoad on MNQ1!, MCL1!, or MGC1!", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.normal)

// Symbol name for webhook
symbol_name = is_mnq ? "MNQ1!" : is_mcl ? "MCL1!" : is_mgc ? "MGC1!" : syminfo.tickerid

// Per-symbol minimum range size
min_range_default = is_mnq ? 20.0 : is_mcl ? 0.50 : is_mgc ? 5.0 : 10.0

// Per-symbol price format (decimal places for webhook)
price_format = is_mcl ? "#.###" : "#.##"

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
range_lookback  = input.int(50,   title="Range Lookback (bars)",                 minval=10, maxval=200)
mid_touch_min   = input.int(2,    title="Min Midpoint Touches for Valid Range",  minval=1)
bos_closes      = input.int(2,    title="BOS Confirmation (consecutive closes)", minval=1, maxval=3)
min_range_pts   = input.float(0,  title="Min Range Size (0 = auto per symbol)",  minval=0.0, step=0.5, tooltip="Leave 0 to use the default for the loaded symbol: MNQ=20, MCL=0.50, MGC=5")
min_rr          = input.float(2.0,title="Minimum R:R to fire signal",            minval=1.0)
show_range      = input.bool(true, title="Show Range on Chart")
show_signals    = input.bool(true, title="Show Signal Arrows")
show_info       = input.bool(true, title="Show Symbol Info Label")

// Use auto min range if input is 0
effective_min_range = min_range_pts == 0 ? min_range_default : min_range_pts

// -----------------------------------------------------------------------------
// SESSION FILTER (UTC times)
// London 07:00-10:00 UTC = 01:00-04:00 CT
// NY     14:00-17:00 UTC = 08:00-11:00 CT
// No-trade 20:00-22:00 UTC = 14:00-16:00 CT
// Hard kill 19:55 UTC = 14:55 CT
// -----------------------------------------------------------------------------
london_session  = time(timeframe.period, "0700-1000:23456")
ny_session      = time(timeframe.period, "1400-1700:23456")
no_trade_zone   = time(timeframe.period, "2000-2200:23456")
hard_kill_zone  = time(timeframe.period, "1955-2000:23456")

in_session      = (not na(london_session) or not na(ny_session)) and na(no_trade_zone) and na(hard_kill_zone)
session_name    = not na(london_session) ? "London" : not na(ny_session) ? "NewYork" : "Outside"

// -----------------------------------------------------------------------------
// RANGE DETECTION
// -----------------------------------------------------------------------------
range_high      = ta.highest(high, range_lookback)
range_low       = ta.lowest(low,   range_lookback)
range_size      = range_high - range_low
range_mid       = (range_high + range_low) / 2.0

touch_threshold = syminfo.mintick * 10

high_touches    = 0
low_touches     = 0
mid_touches     = 0

for i = 0 to range_lookback - 1
    if math.abs(high[i] - range_high) <= touch_threshold
        high_touches += 1
    if math.abs(low[i] - range_low) <= touch_threshold
        low_touches += 1
    if math.abs(close[i] - range_mid) <= touch_threshold or (high[i] >= range_mid and low[i] <= range_mid)
        mid_touches += 1

range_valid = not unsupported and
     range_size      >= effective_min_range and
     high_touches    >= 2 and
     low_touches     >= 2 and
     mid_touches     >= mid_touch_min

// -----------------------------------------------------------------------------
// BOS DETECTION
// -----------------------------------------------------------------------------
bearish_bos         = close[1] > range_high and close[2] > range_high and range_valid
bullish_bos         = close[1] < range_low  and close[2] < range_low  and range_valid

bearish_bos_extreme = bearish_bos ? ta.highest(high, bos_closes + 1) : na
bullish_bos_extreme = bullish_bos ? ta.lowest(low,   bos_closes + 1) : na

// -----------------------------------------------------------------------------
// ENTRY CONDITIONS
// -----------------------------------------------------------------------------
short_entry = bearish_bos and close <= range_high and close > range_mid and in_session
long_entry  = bullish_bos and close >= range_low  and close < range_mid and in_session

// -----------------------------------------------------------------------------
// TRADE LEVELS
// -----------------------------------------------------------------------------
// SHORT
short_entry_price   = close
short_sl            = bearish_bos_extreme
short_tp1           = range_mid
short_tp2           = range_low
short_risk          = not na(short_sl) ? short_sl - short_entry_price : 0.0
short_reward_tp1    = short_entry_price - short_tp1
short_rr_tp1        = short_risk > 0 ? short_reward_tp1 / short_risk : 0.0

// LONG
long_entry_price    = close
long_sl             = bullish_bos_extreme
long_tp1            = range_mid
long_tp2            = range_high
long_risk           = not na(long_sl) ? long_entry_price - long_sl : 0.0
long_reward_tp1     = long_tp1 - long_entry_price
long_rr_tp1         = long_risk > 0 ? long_reward_tp1 / long_risk : 0.0

// R:R filter
short_valid_rr  = short_rr_tp1 >= min_rr
long_valid_rr   = long_rr_tp1  >= min_rr

// Final signals
short_signal    = short_entry and short_valid_rr and not na(short_sl)
long_signal     = long_entry  and long_valid_rr  and not na(long_sl)

// Trade plan
short_action    = short_rr_tp1 >= 3.0 ? "FULL_CLOSE_TP1" : "PARTIAL_CLOSE_TP1"
long_action     = long_rr_tp1  >= 3.0 ? "FULL_CLOSE_TP1" : "PARTIAL_CLOSE_TP1"

// -----------------------------------------------------------------------------
// VISUALS
// -----------------------------------------------------------------------------
plot(show_range and range_valid ? range_high : na, "Range High", color=color.red,    style=plot.style_linebr, linewidth=1)
plot(show_range and range_valid ? range_low  : na, "Range Low",  color=color.green,  style=plot.style_linebr, linewidth=1)
plot(show_range and range_valid ? range_mid  : na, "Range Mid",  color=color.yellow, style=plot.style_linebr, linewidth=1)

plotshape(show_signals and short_signal, title="SHORT Signal", location=location.abovebar, style=shape.triangledown, color=color.red,   size=size.normal)
plotshape(show_signals and long_signal,  title="LONG Signal",  location=location.belowbar, style=shape.triangleup,   color=color.green, size=size.normal)

if bearish_bos
    label.new(bar_index, range_high, "BOS↑", color=color.red,   textcolor=color.white, style=label.style_label_down, size=size.small)
if bullish_bos
    label.new(bar_index, range_low,  "BOS↓", color=color.green, textcolor=color.white, style=label.style_label_up,   size=size.small)

var label info_label = na
label.delete(info_label)
if show_info and barstate.islast
    session_color = in_session ? color.green : color.gray
    info_text = "TPT MASTER\n" +
         "Symbol  : " + symbol_name + "\n" +
         "Session : " + session_name + "\n" +
         "Range   : " + (range_valid ? "VALID ✓" : "INVALID ✗") + "\n" +
         "Min Rng : " + str.tostring(effective_min_range) + " pts\n" +
         "R:R Min : " + str.tostring(min_rr) + ":1"
    info_label := label.new(bar_index, high, info_text, color=session_color, textcolor=color.white, style=label.style_label_left, size=size.small)

bgcolor(in_session ? color.new(color.blue, 92) : na, title="Session Background")

// -----------------------------------------------------------------------------
// WEBHOOK ALERT MESSAGES (JSON for Python server)
// -----------------------------------------------------------------------------
short_alert_msg =
     '{"account":"TPT"' +
     ',"symbol":"'        + symbol_name + '"' +
     ',"direction":"SHORT"' +
     ',"timeframe":"5"' +
     ',"range_high":'     + str.tostring(range_high,        price_format) +
     ',"range_low":'      + str.tostring(range_low,         price_format) +
     ',"range_mid":'      + str.tostring(range_mid,         price_format) +
     ',"bos_extreme":'    + str.tostring(short_sl,          price_format) +
     ',"entry_price":'    + str.tostring(short_entry_price, price_format) +
     ',"stop_loss":'      + str.tostring(short_sl,          price_format) +
     ',"tp1":'            + str.tostring(short_tp1,         price_format) +
     ',"tp2":'            + str.tostring(short_tp2,         price_format) +
     ',"rr_to_tp1":'      + str.tostring(short_rr_tp1,      "#.##") +
     ',"session":"'       + session_name + '"' +
     ',"bar_time":"'      + str.tostring(year) + "-" + str.tostring(month, "00") + "-" + str.tostring(dayofmonth, "00") + " " + str.tostring(hour, "00") + ":" + str.tostring(minute, "00") + '"' +
     ',"token":"tpt_xK9mP2qL8nR4vT7w"}'

long_alert_msg =
     '{"account":"TPT"' +
     ',"symbol":"'        + symbol_name + '"' +
     ',"direction":"LONG"' +
     ',"timeframe":"5"' +
     ',"range_high":'     + str.tostring(range_high,       price_format) +
     ',"range_low":'      + str.tostring(range_low,        price_format) +
     ',"range_mid":'      + str.tostring(range_mid,        price_format) +
     ',"bos_extreme":'    + str.tostring(long_sl,          price_format) +
     ',"entry_price":'    + str.tostring(long_entry_price, price_format) +
     ',"stop_loss":'      + str.tostring(long_sl,          price_format) +
     ',"tp1":'            + str.tostring(long_tp1,         price_format) +
     ',"tp2":'            + str.tostring(long_tp2,         price_format) +
     ',"rr_to_tp1":'      + str.tostring(long_rr_tp1,      "#.##") +
     ',"session":"'       + session_name + '"' +
     ',"bar_time":"'      + str.tostring(year) + "-" + str.tostring(month, "00") + "-" + str.tostring(dayofmonth, "00") + " " + str.tostring(hour, "00") + ":" + str.tostring(minute, "00") + '"' +
     ',"token":"tpt_xK9mP2qL8nR4vT7w"}'

// -----------------------------------------------------------------------------
// ALERT CONDITIONS
// Create these manually: Alerts → + New Alert → pick condition → set webhook URL
// Webhook URL: https://tradingbot-production-1e5a.up.railway.app/webhook/tpt
// -----------------------------------------------------------------------------
alertcondition(short_signal, title="TPT SHORT Signal", message="{{short_alert_msg}}")
alertcondition(long_signal,  title="TPT LONG Signal",  message="{{long_alert_msg}}")