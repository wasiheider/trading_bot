// =============================================================================
// PINE SCRIPT — TPT 5M WYCKOFF BOS MASTER STRATEGY
// =============================================================================
// Strategy : Wyckoff range trading — BOS reversal entries on retracement
// Symbols  : MNQ1! | MCL1! | MGC1! (auto-detected)
// Timeframe: 5 minutes
// Account  : Take Profit Trader → Tradovate → TradingView Desktop
//
// Entry Logic:
//   1. Detect a valid trading range (high/low touched 2+ times, mid touched 2+)
//   2. BOS — 2 consecutive 5m closes beyond range boundary
//   3. Confirmation candle — next candle closes without reversing back
//   4. Wait for retracement back to BOS level (within 100 pts max)
//   5. ATR(14) expanding — current ATR > previous ATR (no chop)
//   6. Entry on retracement candle close near BOS level
//   7. SL beyond BOS extreme wick
//   8. TP1 = range midpoint | TP2 = opposite range boundary
//   9. R:R >= 1:2 required | >= 1:3 = full close at TP1
//
// Contract Scaling by Retracement Distance from BOS:
//   0–50 pts  → 5 contracts (ideal, tightest SL)
//   51–75 pts → 4 contracts (good entry)
//   76–100 pts→ 2 contracts (marginal, minimum size)
//   100+ pts  → no trade   (R:R invalid)
//
// Sessions (CT):
//   Full futures hours: 5:00 PM CT – 3:55 PM CT next day
//   Maintenance block : 4:00 PM – 5:00 PM CT (exchange closed)
//   Hard kill         : 3:55 PM CT (before 4 PM close)
//   Session label     : Asian / London / NewYork / Overnight
//
// Sizing:
//   Risk basis : $45,000 (TPT drawdown limit)
//   Risk/trade : 0.25% = $112.50
//   Contracts  : 2–5 scaled by retracement distance to BOS
//
// Execution: TradingView broker connection (Tradovate) + Webhook to Railway
// =============================================================================

//@version=5
strategy(
     title             = "TPT 5m Wyckoff BOS — Master",
     shorttitle        = "TPT-MASTER",
     overlay           = true,
     pyramiding        = 0,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     currency          = currency.USD,
     commission_type   = strategy.commission.cash_per_contract,
     commission_value  = 0.35
 )

// -----------------------------------------------------------------------------
// SYMBOL AUTO-DETECTION
// -----------------------------------------------------------------------------
is_mnq = str.contains(syminfo.tickerid, "MNQ")
is_mcl = str.contains(syminfo.tickerid, "MCL")
is_mgc = str.contains(syminfo.tickerid, "MGC")

unsupported = not is_mnq and not is_mcl and not is_mgc
var label unsupported_label = na
if unsupported and barstate.islast
    unsupported_label := label.new(bar_index, high, "⚠️ Unsupported symbol.\nLoad on MNQ1!, MCL1!, or MGC1!", color=color.red, textcolor=color.white, style=label.style_label_left, size=size.normal)

symbol_name = is_mnq ? "MNQ1!" : is_mcl ? "MCL1!" : is_mgc ? "MGC1!" : syminfo.tickerid

// Per-symbol minimum range size
min_range_default = is_mnq ? 20.0 : is_mcl ? 0.50 : is_mgc ? 5.0 : 10.0

// Per-symbol price format
price_format = is_mcl ? "#.###" : "#.##"

// Per-symbol tick value (USD per 1 tick move × 1 contract)
tick_value  = is_mnq ? 0.50  : is_mcl ? 10.0 : is_mgc ? 1.0  : 1.0
tick_size   = is_mnq ? 0.25  : is_mcl ? 0.01 : is_mgc ? 0.10 : 0.25
point_value = tick_value / tick_size   // USD per 1 full point per contract

// -----------------------------------------------------------------------------
// SIZING CONSTANTS
// -----------------------------------------------------------------------------
risk_dollars  = 112.50   // 0.25% of $45,000 drawdown basis
min_contracts = 2
max_contracts = 5

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
range_lookback  = input.int(50,    title="Range Lookback (bars)",                 minval=10, maxval=200)
mid_touch_min   = input.int(2,     title="Min Midpoint Touches for Valid Range",  minval=1)
bos_closes      = input.int(2,     title="BOS Confirmation (consecutive closes)", minval=1, maxval=3)
min_range_pts   = input.float(0,   title="Min Range Size (0 = auto per symbol)",  minval=0.0, step=0.5)
min_rr          = input.float(2.0, title="Minimum R:R to fire signal",            minval=1.0)
max_retrace_pts = input.float(100.0, title="Max Retracement from BOS (points)",   minval=10.0, step=5.0)
atr_length      = input.int(14,    title="ATR Length",                            minval=5, maxval=50)
show_range      = input.bool(true, title="Show Range on Chart")
show_signals    = input.bool(true, title="Show Signal Arrows")
show_info       = input.bool(true, title="Show Symbol Info Label")

effective_min_range = min_range_pts == 0 ? min_range_default : min_range_pts

// -----------------------------------------------------------------------------
// SESSION FILTER — Full futures hours (UTC times)
// Market open : 22:00 UTC (5 PM CT) to 21:00 UTC (4 PM CT) next day
// Maintenance : 21:00–22:00 UTC (4–5 PM CT) — exchange closed
// Hard kill   : 20:55 UTC (3:55 PM CT)
// -----------------------------------------------------------------------------
maintenance_zone = time(timeframe.period, "2100-2200:23456")  // 4–5 PM CT
hard_kill_zone   = time(timeframe.period, "2055-2100:23456")  // 3:55–4:00 PM CT

in_session = na(maintenance_zone) and na(hard_kill_zone) and not unsupported

// Session label for Telegram (based on UTC hour)
utc_hour     = hour(time, "UTC")
session_name = utc_hour >= 22 or utc_hour < 2  ? "Asian-Early" :
               utc_hour >= 2  and utc_hour < 7  ? "Asian"       :
               utc_hour >= 7  and utc_hour < 12 ? "London"      :
               utc_hour >= 12 and utc_hour < 17 ? "NewYork"     :
               utc_hour >= 17 and utc_hour < 21 ? "NY-Close"    : "Outside"

// -----------------------------------------------------------------------------
// ATR FILTER — Expanding volatility
// -----------------------------------------------------------------------------
atr_now  = ta.atr(atr_length)
atr_prev = ta.atr(atr_length)[1]
atr_expanding = atr_now > atr_prev

// -----------------------------------------------------------------------------
// RANGE DETECTION
// -----------------------------------------------------------------------------
range_high = ta.highest(high, range_lookback)
range_low  = ta.lowest(low,   range_lookback)
range_size = range_high - range_low
range_mid  = (range_high + range_low) / 2.0

touch_threshold = syminfo.mintick * 10

high_touches = 0
low_touches  = 0
mid_touches  = 0

for i = 0 to range_lookback - 1
    if math.abs(high[i] - range_high) <= touch_threshold
        high_touches += 1
    if math.abs(low[i] - range_low) <= touch_threshold
        low_touches += 1
    if math.abs(close[i] - range_mid) <= touch_threshold or (high[i] >= range_mid and low[i] <= range_mid)
        mid_touches += 1

range_valid = not unsupported and
     range_size   >= effective_min_range and
     high_touches >= 2 and
     low_touches  >= 2 and
     mid_touches  >= mid_touch_min

// -----------------------------------------------------------------------------
// BOS DETECTION
// Two consecutive closes beyond range boundary = confirmed BOS
// -----------------------------------------------------------------------------
bearish_bos = close[1] > range_high and close[2] > range_high and range_valid
bullish_bos = close[1] < range_low  and close[2] < range_low  and range_valid

bearish_bos_extreme = bearish_bos ? ta.highest(high, bos_closes + 1) : na
bullish_bos_extreme = bullish_bos ? ta.lowest(low,   bos_closes + 1) : na

// -----------------------------------------------------------------------------
// BOS STATE TRACKING — Remember last confirmed BOS level and extreme
// Needed to detect retracement candles after BOS is confirmed
// -----------------------------------------------------------------------------
var float last_bearish_bos_level   = na
var float last_bearish_bos_extreme = na
var float last_bullish_bos_level   = na
var float last_bullish_bos_extreme = na
var bool  bearish_bos_active       = false
var bool  bullish_bos_active       = false

// Lock in BOS level when detected, clear when trade fires or price invalidates
if bearish_bos
    last_bearish_bos_level   := range_high
    last_bearish_bos_extreme := bearish_bos_extreme
    bearish_bos_active       := true
    bullish_bos_active       := false  // cancel opposite side

if bullish_bos
    last_bullish_bos_level   := range_low
    last_bullish_bos_extreme := bullish_bos_extreme
    bullish_bos_active       := true
    bearish_bos_active       := false  // cancel opposite side

// -----------------------------------------------------------------------------
// RETRACEMENT DETECTION
// Price returns within max_retrace_pts of the BOS level after confirmation
// Entry candle must close within the retracement zone
// -----------------------------------------------------------------------------

// Distance from current close back to last BOS level
short_retrace_dist = bearish_bos_active and not na(last_bearish_bos_level) ? math.abs(close - last_bearish_bos_level) : na
long_retrace_dist  = bullish_bos_active and not na(last_bullish_bos_level) ? math.abs(close - last_bullish_bos_level) : na

// Retracement is valid when price has pulled back to BOS level within 100 pts
// and candle is now re-entering the range (bearish: close back below BOS level or at it)
short_retracing = bearish_bos_active and not na(short_retrace_dist) and
     short_retrace_dist <= max_retrace_pts and
     close <= last_bearish_bos_level and
     close > range_mid

long_retracing = bullish_bos_active and not na(long_retrace_dist) and
     long_retrace_dist <= max_retrace_pts and
     close >= last_bullish_bos_level and
     close < range_mid

// -----------------------------------------------------------------------------
// CONTRACT SCALING BY RETRACEMENT DISTANCE
// 0–50 pts → 5 contracts | 51–75 → 4 | 76–100 → 2 | 100+ → no trade
// -----------------------------------------------------------------------------
f_contracts_by_distance(dist) =>
    dist <= 50.0 ? 5 :
     dist <= 75.0 ? 4 :
     dist <= 100.0 ? 2 : 0

short_scaled_contracts = not na(short_retrace_dist) ? f_contracts_by_distance(short_retrace_dist) : 0
long_scaled_contracts  = not na(long_retrace_dist)  ? f_contracts_by_distance(long_retrace_dist)  : 0

// -----------------------------------------------------------------------------
// ENTRY CONDITIONS
// All conditions must pass: retracement + ATR expanding + in session + valid R:R
// -----------------------------------------------------------------------------
short_entry_price = close
short_sl          = last_bearish_bos_extreme
short_tp1         = range_mid
short_tp2         = range_low
short_risk        = not na(short_sl) ? short_sl - short_entry_price : 0.0
short_reward_tp1  = short_entry_price - short_tp1
short_rr_tp1      = short_risk > 0 ? short_reward_tp1 / short_risk : 0.0
short_valid_rr    = short_rr_tp1 >= min_rr

long_entry_price  = close
long_sl           = last_bullish_bos_extreme
long_tp1          = range_mid
long_tp2          = range_high
long_risk         = not na(long_sl) ? long_entry_price - long_sl : 0.0
long_reward_tp1   = long_tp1 - long_entry_price
long_rr_tp1       = long_risk > 0 ? long_reward_tp1 / long_risk : 0.0
long_valid_rr     = long_rr_tp1 >= min_rr

short_signal = short_retracing and
     short_scaled_contracts > 0 and
     short_valid_rr and
     not na(short_sl) and
     atr_expanding and
     in_session

long_signal = long_retracing and
     long_scaled_contracts > 0 and
     long_valid_rr and
     not na(long_sl) and
     atr_expanding and
     in_session

short_action = short_rr_tp1 >= 3.0 ? "FULL_CLOSE_TP1" : "PARTIAL_CLOSE_TP1"
long_action  = long_rr_tp1  >= 3.0 ? "FULL_CLOSE_TP1" : "PARTIAL_CLOSE_TP1"

// Half size for TP1 partial close
long_tp1_qty  = math.max(1, math.floor(long_scaled_contracts  / 2))
short_tp1_qty = math.max(1, math.floor(short_scaled_contracts / 2))

// -----------------------------------------------------------------------------
// STRATEGY EXECUTION — AUTO ORDER PLACEMENT VIA TRADOVATE BROKER CONNECTION
// -----------------------------------------------------------------------------
no_position = strategy.position_size == 0

if long_signal and no_position
    strategy.entry("LONG", strategy.long, qty=long_scaled_contracts, comment="BOS LONG " + str.tostring(long_scaled_contracts) + "c @" + str.tostring(math.round(long_retrace_dist)) + "pts")
    strategy.exit("LONG_TP1", from_entry="LONG", qty=long_tp1_qty,  limit=long_tp1, stop=long_sl, comment="TP1")
    strategy.exit("LONG_TP2", from_entry="LONG",                     limit=long_tp2, stop=long_sl, comment="TP2+SL")
    alert('{"account":"TPT","symbol":"' + symbol_name + '","direction":"LONG","timeframe":"5","contracts":' + str.tostring(long_scaled_contracts) + ',"entry_price":' + str.tostring(long_entry_price, price_format) + ',"stop_loss":' + str.tostring(long_sl, price_format) + ',"tp1":' + str.tostring(long_tp1, price_format) + ',"tp2":' + str.tostring(long_tp2, price_format) + ',"rr_to_tp1":' + str.tostring(long_rr_tp1, "#.##") + ',"retrace_pts":' + str.tostring(math.round(long_retrace_dist)) + ',"atr":' + str.tostring(math.round(atr_now, 2)) + ',"bos_level":' + str.tostring(last_bullish_bos_level, price_format) + ',"action":"' + long_action + '","session":"' + session_name + '","token":"tpt_xK9mP2qL8nR4vT7w"}', alert.freq_once_per_bar_close)
    bearish_bos_active := false
    bullish_bos_active := false

if short_signal and no_position
    strategy.entry("SHORT", strategy.short, qty=short_scaled_contracts, comment="BOS SHORT " + str.tostring(short_scaled_contracts) + "c @" + str.tostring(math.round(short_retrace_dist)) + "pts")
    strategy.exit("SHORT_TP1", from_entry="SHORT", qty=short_tp1_qty, limit=short_tp1, stop=short_sl, comment="TP1")
    strategy.exit("SHORT_TP2", from_entry="SHORT",                     limit=short_tp2, stop=short_sl, comment="TP2+SL")
    alert('{"account":"TPT","symbol":"' + symbol_name + '","direction":"SHORT","timeframe":"5","contracts":' + str.tostring(short_scaled_contracts) + ',"entry_price":' + str.tostring(short_entry_price, price_format) + ',"stop_loss":' + str.tostring(short_sl, price_format) + ',"tp1":' + str.tostring(short_tp1, price_format) + ',"tp2":' + str.tostring(short_tp2, price_format) + ',"rr_to_tp1":' + str.tostring(short_rr_tp1, "#.##") + ',"retrace_pts":' + str.tostring(math.round(short_retrace_dist)) + ',"atr":' + str.tostring(math.round(atr_now, 2)) + ',"bos_level":' + str.tostring(last_bearish_bos_level, price_format) + ',"action":"' + short_action + '","session":"' + session_name + '","token":"tpt_xK9mP2qL8nR4vT7w"}', alert.freq_once_per_bar_close)
    bearish_bos_active := false
    bullish_bos_active := false

// Hard kill — close all positions at 3:55 PM CT (20:55 UTC)
if not na(hard_kill_zone)
    strategy.close_all(comment="HARD KILL 3:55 PM CT")
    bearish_bos_active := false
    bullish_bos_active := false

// -----------------------------------------------------------------------------
// VISUALS
// -----------------------------------------------------------------------------
plot(show_range and range_valid ? range_high : na, "Range High", color=color.red,    style=plot.style_linebr, linewidth=1)
plot(show_range and range_valid ? range_low  : na, "Range Low",  color=color.green,  style=plot.style_linebr, linewidth=1)
plot(show_range and range_valid ? range_mid  : na, "Range Mid",  color=color.yellow, style=plot.style_linebr, linewidth=1)

// BOS level lines (persisted after BOS confirmed)
plot(show_range and bearish_bos_active ? last_bearish_bos_level : na, "Bearish BOS Level", color=color.new(color.red,   60), style=plot.style_linebr, linewidth=1)
plot(show_range and bullish_bos_active ? last_bullish_bos_level : na, "Bullish BOS Level", color=color.new(color.green, 60), style=plot.style_linebr, linewidth=1)

plotshape(show_signals and short_signal, title="SHORT Signal", location=location.abovebar, style=shape.triangledown, color=color.red,   size=size.normal)
plotshape(show_signals and long_signal,  title="LONG Signal",  location=location.belowbar, style=shape.triangleup,   color=color.green, size=size.normal)

// BOS labels
if bearish_bos
    label.new(bar_index, range_high, "BOS↑", color=color.red,   textcolor=color.white, style=label.style_label_down, size=size.small)
if bullish_bos
    label.new(bar_index, range_low,  "BOS↓", color=color.green, textcolor=color.white, style=label.style_label_up,   size=size.small)

// Retracement zone labels
if short_retracing and short_scaled_contracts > 0 and not short_signal
    label.new(bar_index, high, "↩ " + str.tostring(math.round(short_retrace_dist)) + "pts", color=color.new(color.red, 70), textcolor=color.white, style=label.style_label_down, size=size.tiny)
if long_retracing and long_scaled_contracts > 0 and not long_signal
    label.new(bar_index, low, "↩ " + str.tostring(math.round(long_retrace_dist)) + "pts", color=color.new(color.green, 70), textcolor=color.white, style=label.style_label_up, size=size.tiny)

// Info label
var label info_label = na
label.delete(info_label)
if show_info and barstate.islast
    session_color = in_session ? (atr_expanding ? color.green : color.orange) : color.gray
    atr_status    = atr_expanding ? "EXPANDING ✓" : "FLAT/CONTRACTING ✗"
    bos_status    = bearish_bos_active ? "BEARISH ACTIVE" : bullish_bos_active ? "BULLISH ACTIVE" : "NONE"
    info_text = "TPT MASTER\n" +
         "Symbol  : " + symbol_name + "\n" +
         "Session : " + session_name + (in_session ? " ✓" : " ✗") + "\n" +
         "Range   : " + (range_valid ? "VALID ✓" : "INVALID ✗") + "\n" +
         "BOS     : " + bos_status + "\n" +
         "ATR(14) : " + atr_status + "\n" +
         "Min Rng : " + str.tostring(effective_min_range) + " pts\n" +
         "R:R Min : " + str.tostring(min_rr) + ":1\n" +
         "Pt Val  : $" + str.tostring(point_value) + "/pt\n" +
         "Risk $  : $" + str.tostring(risk_dollars)
    info_label := label.new(bar_index, high, info_text, color=session_color, textcolor=color.white, style=label.style_label_left, size=size.small)

bgcolor(in_session ? (atr_expanding ? color.new(color.blue, 92) : color.new(color.gray, 92)) : na, title="Session Background")

// -----------------------------------------------------------------------------
// END OF SCRIPT
// One alert per chart needed in TradingView — set webhook to:
// https://tradingbot-production-1e5a.up.railway.app/webhook/tpt
// -----------------------------------------------------------------------------
